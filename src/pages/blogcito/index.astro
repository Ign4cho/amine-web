---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import BlogGridCard from '../../components/blog/BlogGridCard.astro';
import Pagination from '../../components/blog/Pagination.astro';

const POSTS_PER_PAGE = 6;

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const totalPages = Math.ceil(sortedPosts.length / POSTS_PER_PAGE);
const pagePosts = sortedPosts.slice(0, POSTS_PER_PAGE);
const nextUrl = totalPages > 1 ? '/blogcito/page/2' : undefined;
---

<BlogLayout title="Blogcito" description="Artículos sobre marketing digital, redes sociales y crecimiento de marca.">
  <main class="blog-main">
    <!-- Header with section tab -->
    <header class="blog-header">
      <div class="blog-header-tab">
        <img src="/assets/tab-blogcito.png" alt="" class="blog-header-tab-img" aria-hidden="true" />
        <span class="blog-header-tab-label">BLOGCITO</span>
      </div>
      <h1 class="blog-header-title">Blogcito</h1>
      <p class="blog-header-subtitle">Estrategias, consejos y reflexiones sobre el mundo digital.</p>
    </header>

    <!-- 3-column grid -->
    <section class="blog-grid-section">
      {pagePosts.length > 0 ? (
        <div class="blog-grid">
          {pagePosts.map((post) => (
            <BlogGridCard post={post} />
          ))}
        </div>
      ) : (
        <div class="blog-empty">
          <p>Próximamente — el contenido está en camino.</p>
        </div>
      )}

      <Pagination
        currentPage={1}
        totalPages={totalPages}
        nextUrl={nextUrl}
      />
    </section>
  </main>
</BlogLayout>

<style>
  .blog-main {
    min-height: 100vh;
    background-color: #F9F4EA;
  }

  /* Header */
  .blog-header {
    background-color: #2D2A29;
    padding: 0 4rem 3rem;
    text-align: left;
    position: relative;
  }

  .blog-header-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: 319px;
    height: 57px;
    margin-left: -4rem;
    margin-bottom: 2rem;
  }

  .blog-header-tab-img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
  }

  .blog-header-tab-label {
    position: relative;
    z-index: 1;
    margin-left: 50px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.625rem;
    letter-spacing: 0.04em;
    color: #2D2A29;
    line-height: 1;
  }

  .blog-header-title {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: #F9F4EA;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }

  .blog-header-subtitle {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 0.95rem;
    color: rgba(249, 244, 234, 0.75);
    margin: 0;
  }

  /* Grid */
  .blog-grid-section {
    padding: 4rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 335px);
    gap: 2rem;
    justify-content: center;
  }

  .blog-empty {
    text-align: center;
    padding: 4rem 0;
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    color: #5C5753;
    font-size: 1rem;
  }

  @media (max-width: 1100px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .blog-header {
      padding: 0 1.5rem 2rem;
    }

    .blog-header-tab {
      margin-left: -1.5rem;
    }

    .blog-grid-section {
      padding: 2rem 1.5rem;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
