---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import PostCard from '../../components/blogcito/PostCard.astro';
import SideBanner from '../../components/blogcito/SideBanner.astro';
import ComingSoon from '../../components/blogcito/ComingSoon.astro';
import { BLOGCITO_ENABLED } from '../../constants';

// BLOGCITO_ENABLED = false → vuelve el cartel "próximamente" (ComingSoon).
const posts = BLOGCITO_ENABLED
  ? (await getCollection('blogcito', ({ data }) => data.published)).sort(
      (a, b) => a.data.order - b.data.order,
    )
  : [];

// En mobile el banner se intercala en el feed; acá se decide después de
// cuántas notas aparece (en desktop va en el rail, este queda oculto).
const INLINE_BANNER_AFTER = 3;

// Índice de temas del rail: etiquetas con su cantidad de notas. No son links
// (no hay página por tema): es contenido editorial para que la columna
// derecha no quede muerta debajo del banner.
const tagCounts = posts.reduce<Record<string, number>>((acc, post) => {
  const tag = post.data.tag;
  if (tag) acc[tag] = (acc[tag] ?? 0) + 1;
  return acc;
}, {});
const tags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<Layout title={BLOGCITO_ENABLED ? 'Blogcito — Amine Social Media' : 'Blogcito — Próximamente'}>
  {BLOGCITO_ENABLED ? (
    <>
      <header class="bfeed-header">
        <div class="bfeed-header-texture" aria-hidden="true"></div>
        <div class="bfeed-header-inner">
          <h1 class="bfeed-title">Blogcito</h1>
          <p class="bfeed-subtitle">
            Lo que vamos aprendiendo, en voz alta. Sin cuenta de Instagram de la agencia.
          </p>
        </div>
      </header>

      <main class="bfeed-main">
        <div class="bfeed-layout">
          <div class="bfeed-posts">
            {posts.map((post, i) => (
              <>
                <PostCard post={post} />
                {i === INLINE_BANNER_AFTER - 1 && <SideBanner class="bbanner--inline" />}
              </>
            ))}
          </div>

          <div class="bfeed-rail">
            <SideBanner class="bbanner--rail" />

            {tags.length > 0 && (
              <section class="bfeed-tags">
                <h2 class="bfeed-tags-title">De qué escribimos</h2>
                <ul class="bfeed-tags-list">
                  {tags.map(([tag, count]) => (
                    <li class="bfeed-tag">
                      <span>{tag}</span>
                      <span class="bfeed-tag-count">{count}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        </div>
      </main>
    </>
  ) : (
    <ComingSoon />
  )}
</Layout>

<style>
  /* Header oscuro, mismo patrón que /aliados para que las dos secciones
     internas del sitio se lean como familia. */
  .bfeed-header {
    position: relative;
    background-color: #2D2A29;
    padding: 3.5rem 4rem 2rem;
    overflow: hidden;
  }

  .bfeed-header-texture {
    position: absolute;
    inset: 0;
    background-image: url('/assets/texture-bg.png');
    background-size: cover;
    background-position: center;
    opacity: 0.12;
    pointer-events: none;
  }

  .bfeed-header-inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
  }

  .bfeed-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1;
    color: #F9F4EA;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem;
  }

  .bfeed-subtitle {
    font-family: 'Courier Prime', monospace;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    color: rgba(249, 244, 234, 0.8);
    margin: 0;
    max-width: 60ch;
    line-height: 1.5;
  }

  .bfeed-main {
    background-color: #F9F4EA;
    padding: 2.5rem 4rem 5rem;
  }

  .bfeed-layout {
    max-width: 1440px;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 2rem;
    align-items: start;
  }

  .bfeed-posts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.75rem;
  }

  .bfeed-rail {
    position: sticky;
    top: 70px; /* 50px de navbar fija + aire */
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bfeed-tags {
    border: 1.5px dashed rgba(45, 42, 41, 0.35);
    border-radius: 4px;
    padding: 1rem 1.2rem 1.2rem;
  }

  .bfeed-tags-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    color: #2D2A29;
    margin: 0 0 0.6rem;
  }

  .bfeed-tags-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .bfeed-tag {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: 'Courier Prime', monospace;
    font-size: 0.88rem;
    color: #2D2A29;
    border-bottom: 1px dotted rgba(45, 42, 41, 0.25);
    padding-bottom: 0.3rem;
  }

  .bfeed-tag:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .bfeed-tag-count {
    color: #5C5753;
    font-size: 0.8rem;
  }

  /* El banner intercalado solo existe en mobile. */
  .bfeed-posts :global(.bbanner--inline) {
    display: none;
  }

  /* Notebooks de 13-14": con el rail de 300px no entraban 3 columnas y el
     feed caía a 2, alargando la página y el hueco del rail. */
  @media (max-width: 1366px) {
    .bfeed-main {
      padding-left: 2.5rem;
      padding-right: 2.5rem;
    }

    .bfeed-layout {
      grid-template-columns: minmax(0, 1fr) 260px;
      gap: 1.5rem;
    }

    .bfeed-posts {
      gap: 1.25rem;
    }
  }

  @media (max-width: 1000px) {
    .bfeed-header {
      padding: 3rem 2rem 1.75rem;
    }

    .bfeed-main {
      padding: 2rem 2rem 4rem;
    }

    .bfeed-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    /* En mobile/tablet el rail deja de tener sentido: el banner pasa a
       estar intercalado entre las notas (patrón feed). */
    .bfeed-rail {
      display: none;
    }

    .bfeed-posts :global(.bbanner--inline) {
      display: flex;
      grid-column: 1 / -1;
    }
  }

  /* Tablet (761–1000px): la grilla sigue en 2 columnas. Sin `align-self:
     start` las cards se estiran a la altura de la más alta y el "Leer más"
     (margin-top: auto) deja ~90px vacíos en la más corta. */
  @media (min-width: 761px) and (max-width: 1000px) {
    .bfeed-posts > :global(.bpost) {
      align-self: start;
    }

    .bfeed-posts :global(.bbanner--inline) {
      flex-direction: row;
    }

    .bfeed-posts :global(.bbanner--inline) > :global(*) {
      flex: 1 1 0;
    }
  }

  @media (max-width: 760px) {
    .bfeed-header {
      padding: 2.25rem 1.25rem 1.5rem;
    }

    .bfeed-main {
      padding: 1.5rem 1.25rem 3.5rem;
    }

    .bfeed-posts {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
</style>
