---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Blogcito — Próximamente">
  <main class="soon-main">
    <section class="soon-hero">
      <img
        src="/assets/pc-blogcito.png"
        alt="Monitor retro con Amine Blogcitos en pantalla"
        class="soon-pc"
      />

      <div class="soon-copy">
        <h1 class="soon-title">proximamente<span class="soon-dot">.</span></h1>
        <p class="soon-sub">(no queremos tener una cuenta de instagram de la agencia, encontramos una solucion!)</p>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Two-zone background: warm beige (wall) on top, light lavender-gray (desk)
     on bottom. Sharp line between zones, with a soft shadow below (wall casts
     a shadow onto the desk edge). */
  .soon-main {
    min-height: calc(100vh - 50px);
    background:
      /* shadow the wall casts onto the desk, just below the line */
      linear-gradient(
        to bottom,
        transparent 64.5%,
        rgba(0, 0, 0, 0.22) 65%,
        rgba(0, 0, 0, 0) 71%
      ),
      /* base two-tone with hard horizontal split at 65% */
      linear-gradient(
        to bottom,
        #E8D5A3 0%,
        #E8D5A3 65%,
        #D8D5DC 65%,
        #D8D5DC 100%
      );
    display: flex;
    flex-direction: column;
  }

  /* Hero grid rows match the background split so PC can sit ON the line */
  .soon-hero {
    position: relative;
    flex: 1;
    width: 100%;
    display: grid;
    grid-template-rows: 65% 35%;
    grid-template-columns: 45% 55%;
    padding: 0 clamp(1.5rem, 4vw, 4rem) 0 clamp(1rem, 2vw, 2rem);
    min-height: calc(100vh - 50px);
  }

  .soon-pc {
    grid-row: 1;
    grid-column: 1;
    align-self: end;
    justify-self: start;
    display: block;
    width: clamp(260px, 85%, 520px);
    height: auto;
    margin-bottom: 0;
    /* Shift the PC down so the whole keyboard rests on the desk side. */
    transform: translateY(32%);
    filter: drop-shadow(0 18px 22px rgba(45, 42, 41, 0.18));
  }

  .soon-copy {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    justify-self: start;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .soon-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(2.6rem, 5.5vw, 4.5rem);
    line-height: 0.95;
    color: #1A1A1A;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .soon-dot {
    font-style: italic;
  }

  .soon-sub {
    font-family: 'Courier Prime', 'Courier New', monospace;
    font-weight: 400;
    font-size: clamp(0.9rem, 1.2vw, 1.1rem);
    color: #2D2A29;
    line-height: 1.45;
    margin: 0;
    max-width: 68ch;
  }

  @media (max-width: 760px) {
    .soon-main {
      align-items: stretch;
      min-height: 560px;
      background:
        linear-gradient(
          to bottom,
          transparent 63.5%,
          rgba(0, 0, 0, 0.2) 64%,
          rgba(0, 0, 0, 0) 70%
        ),
        linear-gradient(
          to bottom,
          #E8D5A3 0%,
          #E8D5A3 64%,
          #D8D5DC 64%,
          #D8D5DC 100%
        );
    }

    /* Two rows matching the 64/36 background split — PC ends exactly on the line */
    .soon-hero {
      display: grid;
      grid-template-rows: 64% 36%;
      grid-template-columns: 1fr;
      padding: 0;
      gap: 0;
      min-height: 560px;
    }

    .soon-pc {
      grid-row: 1;
      grid-column: 1;
      width: 70%;
      max-width: 360px;
      align-self: end;
      justify-self: center;
      margin-bottom: 0;
      transform: translateY(25%);
    }

    .soon-copy {
      grid-row: 1;
      grid-column: 1;
      align-self: start;
      justify-self: center;
      align-items: center;
      text-align: center;
      padding: 1.5rem 1.5rem 2.5rem;
      max-width: 90%;
    }

    .soon-title {
      text-align: center;
    }

    .soon-sub {
      text-align: center;
      max-width: 100%;
    }
  }
</style>
