---
import Layout from '../layouts/Layout.astro';
import { WHATSAPP_URL, UNDER_CONSTRUCTION } from '../constants';

// Blogcito preview is disabled in this release (shows "proximamente" card).
// To reactivate: restore `getCollection('blog')` + `latestPosts` and the grid markup.
//
// Aliados preview now uses static composed images (aliado-agus/nacho/carpeta.png)
// instead of the `aliados` content collection. The /aliados page still uses the collection.
//
// Hero folder: uses the composed PNG `hero-carpeta-foto.png` (carpeta + foto juntos).
// Si en el futuro se quiere rotar fotos dinámicamente, reemplazar por `hero-carpeta.png`
// de fondo + overlay absoluto con múltiples imágenes (ver commit anterior).
---

<Layout title="Amine Social Media — Agencia de marketing digital">

{UNDER_CONSTRUCTION && (
  <div id="construction-overlay">
    <div id="construction-banner">
      <span class="construction-icon">🚧</span>
      <span class="construction-text">EN CONSTRUCCIÓN</span>
      <span class="construction-icon">🚧</span>
    </div>
  </div>
)}

  <!-- ═══════════════════════════════════════════════ HERO ═══ -->
  <section class="hero">
    <div class="hero-layout">
      <!-- Left: logo + descriptor text -->
      <div class="hero-left">
        <div class="hero-logo-wrap">
          <img
            src="/assets/amine-logo.png"
            alt="Amíne Social Media"
            class="hero-logo"
            loading="eager"
          />
        </div>

        <p class="hero-text">
          Somos una <strong>agencia de marketing digital</strong> con estructura <strong>freelancer</strong> profesional.<br/>
          Trabajamos con marcas desde una estructura colaborativa, donde el <strong>trabajo en equipo</strong> potencia cada talento para generar impacto real.<br/>
          Impulsamos marcas con <strong>creatividad, orden y visión de crecimiento</strong>.
        </p>
        <img src="/assets/stroke-hero.svg" alt="" class="stroke-hero" aria-hidden="true" />
      </div>

      <!-- Right: decorative stars + folder with carousel photo -->
      <div class="hero-right">
        <div class="stars-cluster" aria-hidden="true">
          <img src="/assets/star.png" alt="" class="star star-1" />
          <img src="/assets/star.png" alt="" class="star star-2" />
          <img src="/assets/star.png" alt="" class="star star-3" />
        </div>

        <div class="hero-folder">
          <img src="/assets/hero-carpeta-foto.png" alt="Carpeta Amine" class="hero-folder-img" loading="eager" />
        </div>
      </div>
    </div>

    <!-- NOSOTROS section tab (bottom-left) -->
    <a href="#nosotros" class="section-tab tab-nosotros">
      <span class="section-tab-label">NOSOTROS</span>
    </a>
  </section>

  <!-- ═══════════════════════════════════════════ SERVICES ═══ -->
  <section class="services-section">
    <div class="services-texture" aria-hidden="true"></div>

    <div class="services-inner">
      <!-- Left: title + services list -->
      <div class="services-left">
        <div class="services-title-wrap">
          <h2 class="services-title">Our service</h2>
          <img src="/assets/stroke-services.svg" alt="" class="stroke-services" aria-hidden="true" />
        </div>

        <ul class="services-list">
          <li>
            <span># SOCIAL MEDIA MANAGER</span>
            <img src="/assets/icon-star.svg" alt="" class="service-icon" aria-hidden="true" />
          </li>
          <li>
            <span># SESIONES DE FOTOS Y VIDEOS</span>
            <img src="/assets/icon-camera.svg" alt="" class="service-icon" aria-hidden="true" />
          </li>
          <li>
            <span># DIRECCIÓN CREATIVA</span>
            <img src="/assets/icon-brush.svg" alt="" class="service-icon" aria-hidden="true" />
          </li>
          <li>
            <span># BRANDING</span>
            <img src="/assets/icon-arrow.svg" alt="" class="service-icon" aria-hidden="true" />
          </li>
          <li>
            <span># DESARROLLO WEB</span>
            <img src="/assets/icon-laptop4.svg" alt="" class="service-icon service-icon--laptop" aria-hidden="true" />
          </li>
        </ul>
      </div>

      <!-- Right: composed CTA (note + firma juntos en un único asset) -->
      <div class="services-right">
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-card"
          aria-label="¡Hacé tu consulta! Contactanos por WhatsApp"
        >
          <img src="/assets/cta-con-firma.png" alt="¡Hacé tu consulta!" class="cta-card-img" />
        </a>

        <!-- Affordance clara solo-mobile: el note es un PNG, este link deja
             explícito que lleva a WhatsApp. -->
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="preview-cta preview-cta--light"
        >Escribinos por WhatsApp <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════ ABOUT US ═══ -->
  <section id="nosotros" class="aboutus-section">
    <div class="aboutus-texture" aria-hidden="true"></div>

    <div class="aboutus-inner">
      <!-- Left: text content -->
      <div class="aboutus-left">
        <div class="aboutus-title-row">
          <span class="aboutus-title-inner">
            <img src="/assets/aboutus-redondeo.png" alt="" class="aboutus-redondeo" aria-hidden="true" />
            <h2 class="aboutus-title">About&nbsp;us</h2>
          </span>
          <img src="/assets/estrella.png" alt="" class="aboutus-title-star" aria-hidden="true" />
        </div>

        <p class="aboutus-text">
          <strong>Guadalupe, Luciana, Agustina, Victoria</strong> e <strong>Ignacio</strong>.
          Somos el equipo detrás de la agencia.
          Trabajamos para brindar <strong>soluciones creativas</strong> a las empresas.
          Nos apasiona el trabajo en equipo y colaboramos con cada cliente para ofrecer exactamente lo que necesita.
        </p>

        <!-- TEAM A logo -->
        <div class="teama-wrap">
          <img src="/assets/teama-logo.png" alt="Team A" class="teama-logo" />
        </div>
      </div>

      <!-- Right: clipboard with team photo (foto + gancho ya compuestos en
           un único asset `fotoConGancho.png` — antes eran dos imágenes
           separadas que a veces desalineaban) -->
      <div class="aboutus-photo-wrap">
        <img src="/assets/fotoConGancho.png" alt="Equipo Amine" class="aboutus-photo" />
      </div>
    </div>

    <!-- ALIADOS section tab (bottom-left) -->
    <a href="/aliados" class="section-tab tab-aliados">
      <span class="section-tab-label">ALIADOS</span>
    </a>
    <img src="/assets/estrella.png" alt="" aria-hidden="true" class="tab-aliados-star" />
  </section>

  <!-- ════════════════════════════════════ ALIADOS PREVIEW ═══ -->
  <section class="aliados-preview-section">
    <div class="aliados-preview-inner">
      <div class="aliados-preview-photos">
        <a href="/aliados" class="aliado-photo aliado-photo--agus" aria-label="Agustina Albarracín — área diseño">
          <img src="/assets/aliado-agus.png" alt="Agustina Albarracín — área diseño" />
        </a>
        <a href="/aliados" class="aliado-photo aliado-photo--nacho" aria-label="Ignacio Colomé — área web">
          <img src="/assets/aliado-nacho.png" alt="Ignacio Colomé — área web" />
        </a>
      </div>

      <a href="/aliados" class="aliados-preview-folder" aria-label="Ver todos los aliados">
        <img src="/assets/aliado-carpeta.png" alt="Ver todos los aliados" />
      </a>

      <!-- CTA explícito solo-mobile: en mobile no hay hover, así que el
           enlace a /aliados necesita affordance clara de que es tappable. -->
      <a href="/aliados" class="preview-cta">Conocé a los aliados <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- ══════════════════════════════════ BLOGCITO PREVIEW ═══ -->
  <section class="blogcito-preview-section">
    <!-- BLOGCITO section tab -->
    <a href="/blogcito" class="section-tab tab-blogcito">
      <span class="section-tab-label">BLOGCITO</span>
    </a>

    <div class="blogcito-soon-inner">
      <img
        src="/assets/pc-blogcito.png"
        alt="Monitor retro con Amine Blogcitos en pantalla"
        class="blogcito-soon-pc"
      />
      <div class="blogcito-soon-copy">
        <h2 class="blogcito-soon-title">proximamente<span class="blogcito-soon-dot">.</span></h2>
        <p class="blogcito-soon-sub">(no queremos tener una cuenta de instagram de la agencia, encontramos una solucion!)</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ──────────────────── CONSTRUCTION OVERLAY ──────────────────── */
  #construction-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    background: rgba(45, 42, 41, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: all;
  }

  #construction-banner {
    background: #F0C14B;
    color: #2D2A29;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.8rem, 5vw, 3.5rem);
    letter-spacing: 0.08em;
    padding: 1.2rem 2.8rem;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 8px 32px rgba(0,0,0,0.35);
    text-align: center;
  }

  /* ──────────────────── SHARED SECTION TAB ──────────────────── */
  .section-tab {
    position: absolute;
    display: flex;
    align-items: center;
    width: 319px;
    height: 57px;
    text-decoration: none !important;
    z-index: 2;
    border-radius: 20px 20px 0 0;
    /* Texto justificado a la izquierda, con un respiro del borde redondeado */
    padding-left: 20px;
    justify-content: flex-start;
  }

  .tab-nosotros {
    bottom: 0;
    left: 0;
    background-color: #2D2A29;
    color: #F9F4EA !important;
  }
  .tab-nosotros .section-tab-label {
    color: #F9F4EA !important;
  }

  .tab-aliados {
    bottom: 0;
    left: 0;
    background-color: #F9F4EA;
    color: #2D2A29 !important;
  }
  .tab-aliados .section-tab-label {
    color: #2D2A29 !important;
  }

  .tab-blogcito {
    top: -57px;
    left: 0;
    /* Mismo color que la pared (parte superior del gradiente de la sección) */
    background-color: #E8D5A3;
    color: #2D2A29 !important;
  }
  .tab-blogcito .section-tab-label {
    color: #2D2A29 !important;
  }

  .section-tab-label {
    position: relative;
    z-index: 1;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.625rem;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  /* ─────────────────────────────── HERO ──────────────────────── */
  /* 2-column layout:
       .hero-left  — Amine logo (PNG, justificado a la izquierda) + descriptor + stroke
       .hero-right — cluster de estrellas + carpeta con foto (PNG compuesto)

     La carpeta está intencionalmente "derramada" a la derecha — se extiende
     más allá del borde del viewport via `margin-right` negativo + `overflow: hidden`
     en `.hero` para recortar el exceso. Ajustar `.hero-folder` `width` y
     `.hero-right` `margin-right` para controlar cuánto se "cae" de la página. */
  .hero {
    background-color: #F9F4EA;
    position: relative;
    overflow: hidden;
    /* Padding inferior chico — la sección termina cerca del final del contenido.
       Left padding = 4rem: define el "borde de contenido" global — navbar HOME,
       títulos de sección y textos del hero alinean contra este mismo left-edge. */
    padding: 2.5rem 0 1.5rem 4rem;
  }

  .hero-layout {
    position: relative;
    max-width: 1400px;
    /* margin: 0 (no auto): en monitores anchos el contenido queda pegado
       al padding-left de 4rem en lugar de centrarse. La carpeta ya bleedea
       a la derecha, no necesitamos centrado. */
    margin: 0;
    display: flex;
    align-items: flex-start;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .hero-left {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 1rem;
  }

  .hero-right {
    flex: 0 0 auto;
    position: relative;
    /* Carpeta bien grande, desbordada a la derecha.
       margin-left empuja la carpeta hacia la derecha (más separada del texto);
       margin-right (negativo, más grande) deja que la carpeta se "caiga"
       más allá del viewport. Combinados → la carpeta empieza ~30% más a
       la derecha que la versión previa. */
    width: clamp(520px, 58vw, 900px);
    margin-left: clamp(40px, 6vw, 140px);
    margin-right: clamp(-380px, -22vw, -180px);
    /* Subida hacia arriba para que arranque cerca del top del hero */
    margin-top: -4rem;
  }

  .hero-logo-wrap {
    /* Justificado a la izquierda, mismo borde que el párrafo */
    width: 100%;
    max-width: 547px;
    margin: 0;
    align-self: flex-start;
  }

  .hero-logo {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    /* El PNG del logo trae ~4.31% de padding transparente a la izquierda.
       Lo compensamos con un margin-left negativo para que la "A" visible de
       AMÍNE quede alineada con el borde izquierdo del párrafo de abajo. */
    margin-left: -4.31%;
  }

  .hero-text {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    /* Tamaño reducido ~2pt respecto a la versión anterior */
    font-size: clamp(1.25rem, 2.15vw, 1.95rem);
    color: rgba(0, 0, 0, 0.6);
    line-height: 1.5;
    margin: 0;
    max-width: 820px;
  }

  .hero-text strong {
    font-weight: 600;
    color: rgba(0, 0, 0, 0.8);
  }

  .stroke-hero {
    display: block;
    width: min(480px, 85%);
    height: auto;
    margin-left: clamp(0px, 18vw, 260px);
    margin-top: -0.5rem;
  }

  /* Stars — clustered above the folder on the right column */
  .stars-cluster {
    position: absolute;
    top: -8px;
    right: clamp(80px, 12vw, 200px); /* empujar al centro del área visible de la carpeta */
    width: 380px;
    height: 160px;
    pointer-events: none;
    z-index: 2;
  }

  .star {
    position: absolute;
    display: block;
    object-fit: contain;
  }

  .star-1 {
    right: 0;
    top: 20px;
    width: clamp(110px, 12vw, 175px);
    height: auto;
    rotate: 13deg;
  }

  .star-2 {
    right: 130px;
    top: 36px;
    width: clamp(75px, 8.5vw, 120px);
    height: auto;
    rotate: -5deg;
  }

  .star-3 {
    right: 240px;
    top: 68px;
    width: clamp(58px, 6.5vw, 92px);
    height: auto;
    rotate: 7deg;
  }

  /* Composed folder+photo PNG */
  .hero-folder {
    position: relative;
    width: 100%;
    /* Reducido: carpeta más arriba, solo el aire necesario para las estrellas */
    margin-top: 60px;
  }

  .hero-folder-img {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 32px rgba(45, 42, 41, 0.22));
  }

  /* ──────────────────────────── SERVICES ─────────────────────── */
  .services-section {
    background-color: #2D2A29;
    position: relative;
    overflow: hidden;
    /* Section ends right after the last service / firma — no extra bottom space */
    padding: 5rem 4rem 2rem;
  }

  .services-texture {
    position: absolute;
    inset: 0;
    background-image: url('/assets/texture-bg.png');
    background-size: cover;
    background-position: center;
    opacity: 0.18;
    pointer-events: none;
  }

  .services-inner {
    position: relative;
    z-index: 1;
    /* Match hero-layout max-width + margin:0 (no auto) para que en monitores
       anchos el título "Our Service" y las viñetas queden siempre pegados
       al left-edge de 4rem (mismo que el hero y el navbar HOME). */
    max-width: 1400px;
    margin: 0;
    display: flex;
    align-items: flex-start;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .services-left {
    flex: 1 1 400px;
  }

  .services-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .services-title {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(2.5rem, 6vw, 4.6875rem);
    color: #F9F4EA;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }

  .stroke-services {
    display: block;
    width: min(265px, 80%);
    height: auto;
  }

  .services-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .services-list li {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.4rem, 2.5vw, 2.5rem);
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: -0.02em;
    line-height: 2;
    display: flex;
    align-items: center;
    justify-content: flex-start; /* Icons immediately to the right of text */
    gap: 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.05); /* Optional subtile guide */
    padding-bottom: 0.3rem;
    margin-bottom: 0.3rem;
  }

  /* Todos los íconos del set tienen aspectos muy distintos (0.55 a 1.54).
     Para que se vean "iguales" en la lista, fijamos la MISMA ALTURA y dejamos
     que el ancho se ajuste solo a la proporción de cada uno (sin deformar).
     Así quedan alineados y con peso visual parejo. */
  .service-icon {
    height: 30px;
    width: auto;
    flex-shrink: 0;
  }

  /* Right column: single composed CTA asset (cta-con-firma.png) — el
     texto "¡HACE TU CONSULTA!" y la firma Amine vienen horneados en el PNG,
     por eso no hay overlay de texto ni imagen separada de la firma. */
  .services-right {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    max-width: 600px;
    width: 100%;
  }

  .cta-card {
    position: relative;
    display: block;
    max-width: 600px;
    width: 100%;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .cta-card:hover {
    transform: rotate(-1deg) scale(1.02);
  }

  .cta-card-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  /* ────────────────────────── ABOUT US ───────────────────────── */
  .aboutus-section {
    background-color: #2D2A29;
    position: relative;
    /* Visible overflow so the clipboard photo can exit the section at the bottom */
    overflow: visible;
    /* Section ends right after the TEAM A logo — bottom padding trimmed */
    padding: 5rem 4rem 1.5rem;
  }

  /* New background: fondoHomeFooter rotated 180° + blur, muted */
  .aboutus-texture {
    position: absolute;
    inset: 0;
    background-image: url('/assets/home-footer-bg.png');
    background-size: cover;
    background-position: center;
    filter: grayscale(0.6) blur(4px);
    transform: rotate(180deg) scale(1.08);
    opacity: 0.38;
    pointer-events: none;
    /* Contain the transformed texture within the section */
    overflow: hidden;
  }

  .aboutus-inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    /* Igual que hero/services: pegado al left-edge de 4rem. */
    margin: 0;
    display: flex;
    align-items: flex-start;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .aboutus-left {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Title row: "About us" (with cream oval behind) + decorative star */
  .aboutus-title-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .aboutus-title-inner {
    position: relative;
    display: inline-block;
  }

  .aboutus-redondeo {
    position: absolute;
    /* Tall oval around "About us" — height inflated so the curves sit above/below the caps */
    top: 50%;
    left: 50%;
    transform: translate(-50%, -47%);
    width: 142%;
    height: 674%;
    pointer-events: none;
    z-index: 0;
  }

  .aboutus-title {
    position: relative;
    z-index: 1;
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(3.75rem, 9vw, 6.75rem);
    color: #F9F4EA;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }

  .aboutus-title-star {
    width: clamp(70px, 8vw, 120px);
    height: auto;
    transform: rotate(-10deg);
  }

  .aboutus-text {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: clamp(1.2rem, 2.6vw, 2rem);
    color: #F9F4EA;
    line-height: 1.5;
    margin: 0;
  }

  .aboutus-text strong {
    font-weight: 600;
  }

  /* TEAM A logo */
  .teama-wrap {
    display: flex;
    /* Logo PNG has lots of transparent space above the visible "TEAM A" text.
       Large negative margins collapse that space so the logo sits right under
       the paragraph and the section ends near the logo bottom. */
    margin-top: clamp(-14rem, -15vw, -7rem);
    margin-bottom: clamp(-11rem, -12vw, -5rem);
  }

  .teama-logo {
    display: block;
    width: clamp(300px, 38vw, 540px);
    height: auto;
  }

  /* Clipboard: bulldog clip sitting on top of the team photo, photo tilted
     and dropped below the section edge. Occupies nearly the full right side. */
  .aboutus-photo-wrap {
    flex: 0 0 auto;
    width: clamp(300px, 34vw, 460px);
    position: relative;
    align-self: flex-start;
    /* Lift the whole clipboard up so it no longer "se cae" por la parte
       de abajo de la sección. */
    margin-top: clamp(-7rem, -7vw, -3rem);
    /* Sin sangrado negativo: la foto queda contenida dentro de la sección. */
    margin-bottom: 0;
  }

  .aboutus-photo {
    display: block;
    width: 100%;
    height: auto;
    /* `fotoConGancho.png` es un asset opaco (rectángulo, sin transparencia)
       que trae la foto + el gancho compuestos. Se muestra derecho: rotarlo
       dejaría ver las esquinas del rectángulo claro sobre el fondo oscuro. */
  }

  /* Star sitting *inside* the ALIADOS tab (right side, dentro del tab).
     El tab desktop mide 319×57px, así que el tope del star es ~50px
     (suficiente aire con los bordes redondeados del top del tab). */
  .tab-aliados-star {
    position: absolute;
    bottom: 4px;
