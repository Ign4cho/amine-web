---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { WHATSAPP_URL } from '../constants';

const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const allAliados = await getCollection('aliados');
const featuredAliados = allAliados
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);
---

<Layout title="Amine Social Media — Agencia de marketing digital">

  <!-- ═══════════════════════════════════════════════ HERO ═══ -->
  <section class="hero">
    <!-- Decorative stars — triangular cluster, top-right -->
    <div class="stars-cluster" aria-hidden="true">
      <img src="/assets/star.png" alt="" class="star star-1" />
      <img src="/assets/star.png" alt="" class="star star-2" />
      <img src="/assets/star.png" alt="" class="star star-3" />
    </div>

    <div class="hero-content">
      <!-- Brand image -->
      <div class="hero-logo-wrap">
        <img
          src="/assets/hero-brand.png"
          alt="Amíne Social Media"
          class="hero-logo"
          loading="eager"
        />
      </div>

      <!-- Descriptor text -->
        <p class="hero-text">
          Somos una <strong>agencia de marketing digital</strong> con estructura <strong>freelancer</strong> profesional.<br/>
          Trabajamos con marcas desde una estructura colaborativa, donde el <strong>trabajo en equipo</strong> potencia cada talento para generar impacto real.<br/>
          Impulsamos marcas con <strong>creatividad, orden y visión de crecimiento</strong>.
        </p>
        <img src="/assets/stroke-hero.png" alt="" class="stroke-hero" aria-hidden="true" />
    </div>

    <!-- NOSOTROS section tab (bottom-left) -->
    <a href="#nosotros" class="section-tab tab-nosotros">
      <span class="section-tab-label">NOSOTROS</span>
    </a>
  </section>

  <!-- ═══════════════════════════════════════════ SERVICES ═══ -->
  <section class="services-section">
    <div class="services-texture" aria-hidden="true"></div>

    <div class="services-inner">
      <!-- Left: title + services list -->
      <div class="services-left">
        <div class="services-title-wrap">
          <h2 class="services-title">Our service</h2>
          <img src="/assets/stroke-services.png" alt="" class="stroke-services" aria-hidden="true" />
        </div>

        <ul class="services-list">
          <li>
            <span># SOCIAL MEDIA MANAGER</span>
            <img src="/assets/icon-star.png" alt="" class="service-icon" aria-hidden="true" />
          </li>
          <li>
            <span># SESIONES DE FOTOS Y VIDEOS</span>
            <img src="/assets/icon-camera.png" alt="" class="service-icon" aria-hidden="true" />
          </li>
          <li>
            <span># DIRECCIÓN CREATIVA</span>
            <img src="/assets/icon-brush.png" alt="" class="service-icon" aria-hidden="true" />
          </li>
          <li>
            <span># BRANDING</span>
          </li>
          <li>
            <span># DESARROLLO WEB</span>
            <img src="/assets/icon-arrow.png" alt="" class="service-icon" aria-hidden="true" />
          </li>
        </ul>
      </div>

      <!-- Right: CTA note card -->
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="cta-card"
        aria-label="Contactanos por WhatsApp"
      >
        <img src="/assets/cta-note.png" alt="" class="cta-card-img" aria-hidden="true" />
        <span class="cta-card-text">¡HACE TU<br/>CONSULTA!</span>
      </a>
    </div>
  </section>

  <!-- ══════════════════════════════════════════ ABOUT US ═══ -->
  <section id="nosotros" class="aboutus-section">
    <div class="aboutus-texture" aria-hidden="true"></div>

    <div class="aboutus-inner">
      <!-- Left: text content -->
      <div class="aboutus-left">
        <div class="aboutus-title-wrap">
          <h2 class="aboutus-title">About us</h2>
          <img src="/assets/stroke-aboutus.png" alt="" class="stroke-aboutus" aria-hidden="true" />
        </div>

        <p class="aboutus-text">
          <strong>Guadalupe, Luciana, Agustina, Victoria</strong> e <strong>Ignacio</strong>, el equipo detrás de la agencia.
          Trabajamos para brindar <strong>soluciones creativas</strong> a las empresas.
          Colaboramos con cada cliente para ofrecer exactamente lo que necesita.
        </p>

        <!-- TEAM·A -->
        <div class="teama-wrap">
          <p class="teama-text">
            TEAM
            <img src="/assets/dot-teama.png" alt="" class="teama-dot" aria-hidden="true" />
            A
          </p>
          <img src="/assets/stroke-teama.png" alt="" class="stroke-teama" aria-hidden="true" />
        </div>
      </div>

      <!-- Right: team photo placeholder -->
      <div class="aboutus-photo-wrap">
        <div class="aboutus-photo-placeholder" aria-label="Foto del equipo (próximamente)"></div>
      </div>
    </div>

    <!-- ALIADOS section tab (bottom-left) -->
    <a href="/aliados" class="section-tab tab-aliados">
      <span class="section-tab-label">ALIADOS</span>
    </a>
  </section>

  <!-- ════════════════════════════════════ ALIADOS PREVIEW ═══ -->
  <section class="aliados-preview-section">
    <div class="aliados-preview-inner">
      <!-- Scrapbook cards -->
      <div class="aliados-cards">
        {featuredAliados.length > 0 ? (
          featuredAliados.map((aliado, i) => (
            <div
              class={`aliado-scrap-card aliado-scrap-card--${i === 0 ? 'a' : 'b'}`}
            >
              <div class="aliado-scrap-inner">
                <img
                  src="/assets/aliados-card-bg.png"
                  alt=""
                  class="aliado-scrap-bg"
                  aria-hidden="true"
                />
                <Image
                  src={aliado.data.avatar}
                  alt={aliado.data.name}
                  width={200}
                  height={200}
                  class="aliado-scrap-avatar"
                />
                <p class="aliado-scrap-name">{aliado.data.name}</p>
              </div>
            </div>
          ))
        ) : (
          <>
            <div class="aliado-scrap-card aliado-scrap-card--a">
              <div class="aliado-scrap-inner aliado-scrap-placeholder">
                <p class="aliado-scrap-name">colomÉ</p>
              </div>
            </div>
            <div class="aliado-scrap-card aliado-scrap-card--b">
              <div class="aliado-scrap-inner aliado-scrap-placeholder">
                <p class="aliado-scrap-name">AA estudio</p>
              </div>
            </div>
          </>
        )}
      </div>

      <!-- Right: description text -->
      <div class="aliados-preview-desc">
        <p>
          Profesionales de confianza con quienes colaboramos para potenciar cada proyecto.
          Cada aliado aporta su especialidad al trabajo en equipo.
        </p>
        <a href="/aliados" class="aliados-preview-link">Ver todos →</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ BLOGCITO PREVIEW ═══ -->
  <section class="blogcito-preview-section">
    <!-- BLOGCITO section tab -->
    <a href="/blogcito" class="section-tab tab-blogcito">
      <span class="section-tab-label">BLOGCITO</span>
    </a>

    <div class="blogcito-preview-grid">
      {latestPosts.length > 0 ? (
        latestPosts.map((post) => {
          const slug = post.id.split('/')[0];
          return (
            <a href={`/blogcito/${slug}`} class="blog-preview-card">
              <div class="blog-preview-img-wrap">
                <Image
                  src={post.data.image}
                  alt={post.data.title}
                  width={335}
                  height={407}
                  class="blog-preview-img"
                />
              </div>
              <h3 class="blog-preview-title">{post.data.title}</h3>
              <p class="blog-preview-desc">{post.data.description}</p>
            </a>
          );
        })
      ) : (
        [1, 2, 3].map((n) => (
          <div class="blog-preview-card blog-preview-card--placeholder">
            <div class="blog-preview-img-placeholder"></div>
            <h3 class="blog-preview-title">Próximamente</h3>
            <p class="blog-preview-desc">Descripción breve del artículo.</p>
          </div>
        ))
      )}
    </div>
  </section>
</Layout>

<style>
  /* ──────────────────── SHARED SECTION TAB ──────────────────── */
  .section-tab {
    position: absolute;
    display: flex;
    align-items: center;
    width: 319px;
    height: 57px;
    text-decoration: none !important;
    z-index: 2;
    border-radius: 20px 20px 0 0;
    padding-left: 50px;
  }

  .tab-nosotros {
    bottom: 0;
    left: 0;
    background-color: #2D2A29;
    color: #F9F4EA !important;
  }
  .tab-nosotros .section-tab-label {
    color: #F9F4EA !important;
  }

  .tab-aliados {
    bottom: 0;
    left: 0;
    background-color: #F9F4EA;
    color: #2D2A29 !important;
  }
  .tab-aliados .section-tab-label {
    color: #2D2A29 !important;
  }

  .tab-blogcito {
    top: -57px;
    left: 0;
    background-color: #F0C14B; /* Mustard to stand out on cream */
    color: #2D2A29 !important;
  }
  .tab-blogcito .section-tab-label {
    color: #2D2A29 !important;
  }

  .section-tab-label {
    position: relative;
    z-index: 1;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.625rem;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  /* ─────────────────────────────── HERO ──────────────────────── */
  .hero {
    background-color: #F9F4EA;
    position: relative;
    overflow: hidden;
    padding: 3rem 4rem 5rem;
    min-height: 640px;
  }

  /* Stars — large absolute container at top-right of hero */
  .stars-cluster {
    position: absolute;
    top: 0;
    right: 0;
    width: 400px;
    height: 400px;
    pointer-events: none;
  }

  .star {
    position: absolute;
    display: block;
    object-fit: contain;
  }

  /* Star 1: largest, top right */
  .star-1 {
    right: 20px;
    top: 45px;
    width: 155px;
    height: auto;
    rotate: 13deg;
  }

  /* Star 2: medium, top left */
  .star-2 {
    right: 215px;
    top: 65px;
    width: 105px;
    height: auto;
    rotate: -5deg;
  }

  /* Star 3: small, bottom center */
  .star-3 {
    right: 110px;
    top: 215px;
    width: 80px;
    height: auto;
    rotate: 7deg;
  }

  .hero-content {
    max-width: 1100px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 2rem;
  }

  .hero-logo-wrap {
    max-width: 547px;
    width: 100%;
  }

  .hero-logo {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .hero-text-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 100%; /* Allow text to span the full available width */
  }

  .hero-text {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: clamp(1rem, 2vw, 1.5625rem);
    color: rgba(0, 0, 0, 0.55);
    line-height: 1.45;
    margin: 0;
  }

  .hero-text strong {
    font-weight: 600;
  }

  .stroke-hero {
    display: block;
    width: min(527px, 100%);
    height: auto;
    margin-left: 250px; /* Aligns with "creatividad, orden..." start point */
    margin-top: -0.5rem;
  }

  /* ──────────────────────────── SERVICES ─────────────────────── */
  .services-section {
    background-color: #2D2A29;
    position: relative;
    overflow: hidden;
    padding: 5rem 4rem 5rem;
  }

  .services-texture {
    position: absolute;
    inset: 0;
    background-image: url('/assets/texture-bg.png');
    background-size: cover;
    background-position: center;
    opacity: 0.18;
    pointer-events: none;
  }

  .services-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .services-left {
    flex: 1 1 400px;
  }

  .services-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .services-title {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(2.5rem, 6vw, 4.6875rem);
    color: #F9F4EA;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }

  .stroke-services {
    display: block;
    width: min(265px, 80%);
    height: auto;
  }

  .services-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .services-list li {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.4rem, 2.5vw, 2.5rem);
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: -0.02em;
    line-height: 2;
    display: flex;
    align-items: center;
    justify-content: flex-start; /* Icons immediately to the right of text */
    gap: 1rem;
    border-bottom: 1px solid rgba(255,255,255,0.05); /* Optional subtile guide */
    padding-bottom: 0.3rem;
    margin-bottom: 0.3rem;
  }

  .service-icon {
    width: 36px;
    height: 36px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .cta-card {
    flex: 0 0 auto;
    position: relative;
    display: block;
    max-width: 480px; /* Increased size to match Figma proportions */
    width: 100%;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .cta-card:hover {
    transform: rotate(-1deg) scale(1.02);
  }

  .cta-card-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  .cta-card-text {
    position: absolute;
    top: 50%;
    left: 48%; /* Adjust for visual center within the paper texture */
    transform: translate(-50%, -55%);
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(1.2rem, 3vw, 2.3rem);
    color: #2D2A29;
    text-align: center;
    line-height: 1.1;
    letter-spacing: -0.02em;
    pointer-events: none;
    width: 75%;
  }

  /* ────────────────────────── ABOUT US ───────────────────────── */
  .aboutus-section {
    background-color: #2D2A29;
    position: relative;
    overflow: hidden;
    padding: 5rem 4rem 6rem;
  }

  .aboutus-texture {
    position: absolute;
    inset: 0;
    background-image: url('/assets/texture-aboutus.png');
    background-size: cover;
    background-position: center;
    opacity: 0.25;
    pointer-events: none;
  }

  .aboutus-inner {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .aboutus-left {
    flex: 1 1 400px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .aboutus-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .aboutus-title {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(3rem, 7vw, 5rem);
    color: #F9F4EA;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0;
  }

  .stroke-aboutus {
    display: block;
    width: min(245px, 80%);
    height: auto;
  }

  .aboutus-text {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: clamp(1rem, 2vw, 1.5625rem);
    color: #F9F4EA;
    line-height: 1.5;
    margin: 0;
    white-space: pre-line;
  }

  .aboutus-text strong {
    font-weight: 600;
  }

  /* TEAM·A */
  .teama-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 1rem;
  }

  .teama-text {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3rem, 7vw, 5.3125rem);
    color: #F9F4EA;
    letter-spacing: 0.02em;
    line-height: 1;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .teama-dot {
    width: 13px;
    height: 13px;
    object-fit: contain;
    flex-shrink: 0;
    margin-bottom: 0.6em;
  }

  .stroke-teama {
    display: block;
    width: min(185px, 60%);
    height: auto;
    margin-left: 2px;
  }

  /* Team photo */
  .aboutus-photo-wrap {
    flex: 0 0 auto;
    width: min(511px, 100%);
    align-self: stretch;
    display: flex;
    align-items: stretch;
  }

  .aboutus-photo-placeholder {
    width: 100%;
    min-height: 500px;
    background-color: #D9D9D9;
    border-radius: 4px;
  }

  /* ─────────────────────── ALIADOS PREVIEW ───────────────────── */
  .aliados-preview-section {
    background-color: #F9F4EA;
    padding: 5rem 4rem 5rem;
    position: relative;
    overflow: hidden;
  }

  .aliados-preview-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 4rem;
    flex-wrap: wrap;
    padding-top: 2rem;
  }

  .aliados-cards {
    flex: 1 1 400px;
    position: relative;
    height: 420px;
    min-width: 360px;
  }

  .aliado-scrap-card {
    position: absolute;
    width: 280px;
    height: 340px;
  }

  .aliado-scrap-card--a {
    left: 0;
    top: 20px;
    transform: rotate(-5.08deg);
    z-index: 2;
  }

  .aliado-scrap-card--b {
    left: 200px;
    top: 40px;
    transform: rotate(4.42deg);
    z-index: 1;
  }

  .aliado-scrap-inner {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 4px;
    background-color: #D9D9D9;
    display: flex;
    align-items: flex-end;
    padding: 1rem;
  }

  .aliado-scrap-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .aliado-scrap-avatar {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .aliado-scrap-placeholder {
    background-color: #C0B8AE;
  }

  .aliado-scrap-name {
    position: relative;
    z-index: 1;
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    color: #2C2527;
    margin: 0;
    line-height: 1;
    text-shadow: 0 1px 4px rgba(249, 244, 234, 0.7);
  }

  .aliados-preview-desc {
    flex: 1 1 250px;
    max-width: 335px;
  }

  .aliados-preview-desc p {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: clamp(1rem, 2vw, 1.5625rem);
    color: #2C2527;
    line-height: 1.5;
    margin: 0 0 1.5rem;
  }

  .aliados-preview-link {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    color: #2D2A29;
    text-decoration: none;
    border-bottom: 2px solid #F0C14B;
    padding-bottom: 2px;
    transition: opacity 0.15s ease;
  }

  .aliados-preview-link:hover {
    opacity: 0.65;
  }

  /* ────────────────────── BLOGCITO PREVIEW ───────────────────── */
  .blogcito-preview-section {
    background-color: #F9F4EA;
    padding: 5rem 4rem 5rem;
    position: relative;
  }

  .blogcito-preview-grid {
    max-width: 1200px;
    margin: 3.5rem auto 0;
    display: grid;
    grid-template-columns: repeat(3, 335px);
    gap: 1.5rem;
    justify-content: center;
  }

  .blog-preview-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background-color: #ffffff;
    transition: transform 0.2s ease;
  }

  .blog-preview-card:hover {
    transform: translateY(-4px);
  }

  .blog-preview-img-wrap {
    width: 335px;
    height: 407px;
    overflow: hidden;
    background-color: #D9D9D9;
  }

  .blog-preview-img-placeholder {
    width: 335px;
    height: 407px;
    background-color: #D9D9D9;
  }

  .blog-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .blog-preview-card:hover .blog-preview-img {
    transform: scale(1.04);
  }

  .blog-preview-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2rem, 4.5vw, 4.0625rem);
    color: #2C2527;
    letter-spacing: -0.01em;
    line-height: 1;
    margin: 0.75rem 0 0.4rem;
  }

  .blog-preview-desc {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: clamp(0.875rem, 1.5vw, 1.25rem);
    color: #2C2527;
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ────────────────────── RESPONSIVE ────────────────────────── */
  @media (max-width: 900px) {
    .hero {
      padding: 2rem 1.5rem 4rem;
      min-height: auto;
    }

    .stars-cluster {
      width: 200px;
      height: 220px;
    }

    .star-1 { right: 8px;  top: 80px;  width: 60px; height: 58px; }
    .star-2 { right: 84px; top: 84px;  width: 48px; height: 46px; }
    .star-3 { right: 32px; top: 150px; width: 42px; height: 40px; }

    .stroke-hero {
      margin-left: 0;
    }

    .services-section,
    .aboutus-section,
    .aliados-preview-section,
    .blogcito-preview-section {
      padding: 3.5rem 1.5rem 4rem;
    }

    .services-inner,
    .aboutus-inner,
    .aliados-preview-inner {
      flex-direction: column;
