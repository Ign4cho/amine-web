---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const aliados = await getCollection('aliados');
const sorted = aliados.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Aliados — Amine Social Media">

  <header class="aliados-header">
    <div class="aliados-header-texture" aria-hidden="true"></div>
    <div class="aliados-header-inner">
      <h1 class="aliados-title">Aliados</h1>
      <p class="aliados-subtitle">
        Profesionales de confianza con quienes colaboramos para potenciar cada proyecto.
      </p>
    </div>
  </header>

  <main class="aliados-main">
    <div class="aliados-grid">
      {sorted.map((aliado, i) => {
        const reverse = i % 2 === 1;
        const photoSrc = aliado.data.photo ?? aliado.data.avatar;
        const slug = aliado.id.split('/')[0];
        return (
          <article class={`aliado aliado--${slug} ${reverse ? 'aliado--reverse' : ''}`}>
            <div class="aliado-photo-col">
              {aliado.data.portfolio ? (
                <a
                  href={aliado.data.portfolio}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="aliado-photo-link"
                  aria-label={`Ver portfolio de ${aliado.data.name}`}
                >
                  <Image
                    src={photoSrc}
                    alt={aliado.data.name}
                    width={900}
                    height={1100}
                    class="aliado-photo"
                  />
                </a>
              ) : (
                <Image
                  src={photoSrc}
                  alt={aliado.data.name}
                  width={900}
                  height={1100}
                  class="aliado-photo aliado-photo--static"
                />
              )}
            </div>

            <div class="aliado-info-col">
              <div class={`aliado-paper-wrap aliado-paper-wrap--${slug}`}>
                {aliado.data.paper && (
                  <Image
                    src={aliado.data.paper}
                    alt=""
                    class="aliado-paper-bg"
                    aria-hidden="true"
                  />
                )}
                <div class="aliado-paper-content">
                  <p class="aliado-services-title">Servicios</p>
                  <ul class="aliado-services">
                    {aliado.data.services.map((service) => (
                      <li>{service}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="aliado-services-plain">
                <p class="aliado-services-plain-title">Servicios</p>
                <ul class="aliado-services-plain-list">
                  {aliado.data.services.map((service) => (
                    <li>{service}</li>
                  ))}
                </ul>
              </div>

              {aliado.data.logo && (
                <Image
                  src={aliado.data.logo}
                  alt={aliado.data.name}
                  class="aliado-logo"
                />
              )}

              <p class="aliado-description">{aliado.data.description}</p>

              <a
                href={`mailto:${aliado.data.contact.value}`}
                class="aliado-email-btn"
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="2" y="4" width="20" height="16" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
                {aliado.data.contact.value}
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </main>
</Layout>

<style>
  /* Header */
  .aliados-header {
    background-color: #2D2A29;
    position: relative;
    overflow: hidden;
    /* Bottom padding reducido para que el grid de aliados arranque cerca
       del subtítulo del header */
    padding: 0 4rem 1.5rem;
  }

  .aliados-header-texture {
    position: absolute;
    inset: 0;
    background-image: url('/assets/texture-bg.png');
    background-size: cover;
    background-position: center;
    opacity: 0.15;
    pointer-events: none;
  }

  .aliados-header-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
  }

  .aliados-title {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(3rem, 8vw, 5rem);
    color: #F9F4EA;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
    line-height: 1;
    padding-top: 2.5rem;
  }

  .aliados-subtitle {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 1rem;
    color: rgba(249, 244, 234, 0.75);
    margin: 0;
  }

  /* Main */
  .aliados-main {
    background-color: #F9F4EA;
    /* Recorta el leve desborde de la polaroid rotada cuando llena el ancho
       en mobile (evita scroll horizontal). */
    overflow-x: hidden;
  }

  .aliados-grid {
    max-width: 1400px;
    margin: 0 auto;
    /* Top padding mínimo: las polaroids arrancan apenas debajo del header */
    padding: 1rem 4rem 3rem;
    display: flex;
    flex-direction: column;
    /* Secciones casi pegadas — poco aire entre aliados */
    gap: 1.5rem;
  }

  .aliado {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: 1.5rem;
    align-items: start;
  }

  .aliado--reverse {
    grid-template-columns: 4fr 7fr;
  }

  .aliado:not(:last-child) {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(45, 42, 41, 0.18);
  }

  .aliado--reverse .aliado-photo-col {
    order: 2;
  }

  .aliado--reverse .aliado-info-col {
    order: 1;
  }

  /* Photo */
  .aliado-photo-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .aliado-photo-link,
  .aliado-photo--static {
    display: block;
    transform: rotate(-3deg);
    transition: transform 400ms ease;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.2));
  }

  .aliado--reverse .aliado-photo-link,
  .aliado--reverse .aliado-photo--static {
    transform: rotate(3deg);
  }

  .aliado-photo-link:hover {
    transform: rotate(-1deg) scale(1.02);
  }

  .aliado--reverse .aliado-photo-link:hover {
    transform: rotate(1deg) scale(1.02);
  }

  .aliado-photo {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Info column */
  .aliado-info-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 1rem;
  }

  /* Paper */
  .aliado-paper-wrap {
    position: relative;
    align-self: flex-end;
  }

  .aliado--reverse .aliado-paper-wrap {
    align-self: flex-start;
  }

  /* Per-aliado paper sizing/padding (different PNG proportions) */
  .aliado-paper-wrap--agustina-albarracin {
    width: 380px;
  }

  .aliado-paper-wrap--agustina-albarracin .aliado-paper-content {
    padding: 18% 16% 18% 14%;
  }

  .aliado-paper-wrap--ignacio-colome {
    width: 520px;
  }

  .aliado-paper-wrap--ignacio-colome .aliado-paper-content {
    padding: 10% 10% 28% 14%;
    gap: 0;
  }

  .aliado-paper-wrap--ignacio-colome .aliado-services-title {
    margin: 0;
  }

  .aliado-paper-bg {
    display: block;
    width: 100%;
    height: auto;
  }

  .aliado-paper-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: #2D2A29;
  }

  .aliado-services-title {
    font-family: 'Glacial Indifference', 'Outfit', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.4rem;
    margin: 0 0 0.3rem;
    letter-spacing: 0.01em;
  }

  .aliado-services {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: 'Glacial Indifference', 'Outfit', system-ui, sans-serif;
    font-weight: 400;
    font-size: 1.2rem;
    line-height: 1.4;
  }

  /* Plain services list (mobile only) */
  .aliado-services-plain {
    display: none;
  }

  .aliado-services-plain-title {
    font-family: 'Courier Prime', 'Courier New', monospace;
    font-weight: 700;
    font-size: 1.1rem;
    color: #2D2A29;
    margin: 0 0 0.4rem;
  }

  .aliado-services-plain-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-family: 'Courier Prime', 'Courier New', monospace;
    font-weight: 400;
    font-size: 1.05rem;
    color: #2D2A29;
    line-height: 1.5;
  }

  /* Logo */
  .aliado-logo {
    display: block;
    width: clamp(280px, 55%, 440px);
    height: auto;
    margin: 0;
  }

  /* Description */
  .aliado-description {
    font-family: 'Courier Prime', 'Courier New', monospace;
    font-weight: 400;
    font-size: 1.2rem;
    color: #2D2A29;
    line-height: 1.6;
    margin: 0;
    max-width: 640px;
  }

  /* Email button */
  .aliado-email-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: flex-start;
    margin-top: 0.5rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    letter-spacing: 0.06em;
    color: #2D2A29;
    background: #F0C14B;
    border-radius: 10px;
    padding: 0.75rem 1.6rem;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .aliado-email-btn:hover {
    background: #2D2A29;
    color: #F0C14B;
  }

  @media (max-width: 1100px) {
    .aliado-paper-wrap--ignacio-colome {
      width: 100%;
      max-width: 480px;
    }
    .aliado-paper-wrap--agustina-albarracin {
      width: 100%;
      max-width: 360px;
    }
  }

  @media (max-width: 900px) {
    .aliados-header {
      padding: 0 1.5rem 1rem;
    }

    .aliados-header-tab {
      margin-left: -1.5rem;
    }

    .aliados-grid {
      /* Menos aire vertical: la foto full-bleed ya es grande, no necesita
         tanto padding arriba ni gap entre aliados. */
      padding: 1rem 1.5rem 2rem;
      gap: 2rem;
    }

    .aliado,
    .aliado--reverse {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .aliado--reverse .aliado-photo-col {
      order: 0;
    }

    .aliado--reverse .aliado-info-col {
      order: 0;
    }

    /* Pasamos la columna de la foto a flujo normal (block). El truco de
       full-bleed (margin-left: calc(50% - Wvw)) es confiable en block flow,
       pero falla dentro de un flex container + ancestros con overflow-x:hidden
       (que es justo el caso: html/body y .aliados-main lo tienen). */
    .aliado-photo-col {
      display: block;
      max-width: none;
    }

    /* Polaroid full-bleed a 105vw: el marco blanco pasa de los bordes de la
       pantalla. margin-left: calc(50% - 52.5vw) la centra (desborda 2.5vw por
       lado). El overflow-x:hidden global recorta lo que sobra. */
    .aliado-photo-link,
    .aliado-photo--static {
      display: block;
      width: 105vw;
      max-width: none;
      margin-left: calc(50% - 52.5vw);
      /* El PNG de la foto trae ~21% de padding transparente arriba y abajo.
         A 105vw de ancho eso son ~27vw de alto vacío por lado. Lo colapsamos
         con margen negativo para que no haya tanto aire arriba/abajo. */
      margin-top: -24vw;
      margin-bottom: -24vw;
    }

    .aliado-paper-wrap--agustina-albarracin,
    .aliado-paper-wrap--ignacio-colome {
      display: none;
    }

    .aliado-services-plain {
      display: block;
    }

    .aliado-services-title {
      font-size: 1.2rem;
    }

    .aliado-services {
      font-size: 1.05rem;
    }

    .aliado-description {
      font-size: 1.05rem;
    }
  }
</style>
