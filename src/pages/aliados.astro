---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const aliados = await getCollection('aliados');
const sorted = aliados.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Aliados — Amine Social Media">

  <header class="aliados-header">
    <div class="aliados-header-texture" aria-hidden="true"></div>
    <div class="aliados-header-inner">
      <h1 class="aliados-title">Aliados</h1>
      <p class="aliados-subtitle">
        Profesionales de confianza con quienes colaboramos para potenciar cada proyecto.
      </p>
    </div>
  </header>

  <main class="aliados-main">
    <div class="aliados-grid">
      {sorted.map((aliado, i) => {
        const reverse = i % 2 === 1;
        const photoSrc = aliado.data.photo ?? aliado.data.avatar;
        const slug = aliado.id.split('/')[0];
        return (
          <article class={`aliado aliado--${slug} ${reverse ? 'aliado--reverse' : ''}`}>
            <header class="aliado-head">
              <span class="aliado-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h2 class="aliado-name">{aliado.data.name}</h2>
              {aliado.data.area && <span class="aliado-area">área {aliado.data.area}</span>}
            </header>

            <div class="aliado-photo-col">
              {aliado.data.portfolio ? (
                <a
                  href={aliado.data.portfolio}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="aliado-photo-link"
                  aria-label={`Ver portfolio de ${aliado.data.name}`}
                >
                  <Image
                    src={photoSrc}
                    alt={aliado.data.name}
                    width={900}
                    height={1100}
                    class="aliado-photo"
                  />
                </a>
              ) : (
                <Image
                  src={photoSrc}
                  alt={aliado.data.name}
                  width={900}
                  height={1100}
                  class="aliado-photo aliado-photo--static"
                />
              )}
            </div>

            <div class="aliado-info-col">
              <div class={`aliado-paper-wrap aliado-paper-wrap--${slug}`}>
                {aliado.data.paper && (
                  <Image
                    src={aliado.data.paper}
                    alt=""
                    class="aliado-paper-bg"
                    aria-hidden="true"
                  />
                )}
                <div class="aliado-paper-content">
                  <p class="aliado-services-title">Servicios</p>
                  <ul class="aliado-services">
                    {aliado.data.services.map((service) => (
                      <li>{service}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="aliado-services-plain">
                <p class="aliado-services-plain-title">Servicios</p>
                <ul class="aliado-services-plain-list">
                  {aliado.data.services.map((service) => (
                    <li>{service}</li>
                  ))}
                </ul>
              </div>

              {aliado.data.logo && (
                <Image
                  src={aliado.data.logo}
                  alt={aliado.data.name}
                  class="aliado-logo"
                />
              )}

              <p class="aliado-description">{aliado.data.description}</p>

              <div class="aliado-actions">
                <a
                  href={`mailto:${aliado.data.contact.value}`}
                  class="aliado-email-btn"
                >
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2"/>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                  </svg>
                  {aliado.data.contact.value}
                </a>

                {aliado.data.portfolio && (
                  <a
                    href={aliado.data.portfolio}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="aliado-portfolio-cta"
                    aria-label={`Ver portfolio de ${aliado.data.name}`}
                  >Ver portfolio <span aria-hidden="true">→</span></a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </main>
</Layout>

<style>
  /* Header */
  .aliados-header {
    background-color: #2D2A29;
    position: relative;
    overflow: hidden;
    /* Bottom padding reducido para que el grid de aliados arranque cerca
       del subtítulo del header */
    padding: 3.5rem 4rem 2rem;
  }

  .aliados-header-texture {
    position: absolute;
    inset: 0;
    background-image: url('/assets/texture-bg.png');
    background-size: cover;
    background-position: center;
    opacity: 0.12;
    pointer-events: none;
  }

  .aliados-header-inner {
    position: relative;
    z-index: 1;
    /* Anclado a la izquierda como el resto del sitio (hero/services/blogcito).
       Con `margin: 0 auto` el título quedaba a la derecha del borde de las
       hojas en pantallas anchas. */
    max-width: 1280px;
    margin: 0;
  }

  .aliados-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3rem, 7vw, 5.5rem);
    color: #F9F4EA;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem;
    line-height: 1;
  }

  .aliados-subtitle {
    font-family: 'Courier Prime', monospace;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    color: rgba(249, 244, 234, 0.8);
    margin: 0;
    max-width: 60ch;
    line-height: 1.5;
  }

  /* Main */
  .aliados-main {
    background-color: #F9F4EA;
    position: relative;
    /* Recorta el leve desborde de la polaroid rotada cuando llena el ancho
       en mobile (evita scroll horizontal). */
    overflow-x: hidden;
  }

  /* Papel cuadriculado tenue de fondo: el cream plano dejaba la página
     "desnuda" (feedback PO, oct 2026). Se hace con gradientes (no PNG) para
     que no pese ni se vea sucio, y rima con el papel cuadriculado de uno de
     los aliados. Es fondo: no compite con el collage. */
  .aliados-main::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        to right,
        rgba(45, 42, 41, 0.055) 0 1px,
        transparent 1px 32px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(45, 42, 41, 0.055) 0 1px,
        transparent 1px 32px
      );
    pointer-events: none;
    z-index: 0;
  }

  .aliados-grid {
    position: relative;
    z-index: 1;
  }

  .aliados-grid {
    max-width: 1400px;
    margin: 0;
    /* Top padding mínimo: las polaroids arrancan apenas debajo del header */
    padding: 3rem 4rem 4.5rem;
    display: flex;
    flex-direction: column;
    /* Aire entre hojas: suficiente para que se lean como piezas separadas. */
    gap: 3rem;
  }

  /* Cada aliado es una "hoja" apoyada sobre la página: fondo propio, borde
     fino, sombra dura y una rotación mínima alternada. Antes eran dos bloques
     sueltos separados por una línea gris, con mucho aire muerto alrededor. */
  .aliado {
    position: relative;
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: 1.5rem 2rem;
    align-items: center;
    /* Semitransparente a propósito: deja ver la cuadrícula del fondo, si no
       las hojas la tapaban y el papel solo se veía en los márgenes. */
    background: rgba(255, 253, 248, 0.9);
    border: 1.5px solid rgba(45, 42, 41, 0.22);
    border-radius: 6px;
    box-shadow: 10px 10px 0 rgba(45, 42, 41, 0.15);
    padding: 1.75rem 2.25rem 1.5rem;
    transform: rotate(-0.4deg);
  }

  .aliado--reverse {
    grid-template-columns: 4fr 7fr;
    transform: rotate(0.4deg);
  }

  /* Encabezado de la hoja: número grande en marca de agua + nombre + área.
     El nombre no estaba en ningún lado fuera del PNG de la polaroid. */
  .aliado-head {
    grid-column: 1 / -1;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    border-bottom: 1.5px dashed rgba(45, 42, 41, 0.25);
    padding-bottom: 0.9rem;
  }

  .aliado-index {
    position: absolute;
    top: 0.1rem;
    right: 2.25rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(4rem, 7vw, 7rem);
    line-height: 1;
    color: rgba(45, 42, 41, 0.08);
    pointer-events: none;
    user-select: none;
  }

  .aliado-name {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    color: #2D2A29;
    letter-spacing: -0.015em;
    margin: 0;
    line-height: 1.1;
  }

  .aliado-area {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(0.95rem, 1.2vw, 1.15rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2D2A29;
    background: #F0C14B;
    border: 1.5px solid #2D2A29;
    border-radius: 999px;
    padding: 2px 14px 0;
  }

  .aliado--reverse .aliado-photo-col {
    order: 2;
  }

  .aliado--reverse .aliado-info-col {
    order: 1;
  }

  /* Photo */
  .aliado-photo-col {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .aliado-photo-link,
  .aliado-photo--static {
    display: block;
    transform: rotate(-3deg);
    transition: transform 400ms ease;
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.2));
    /* Los PNG de las polaroids traen ~18% de padding transparente arriba y
       abajo: sin colapsarlo, la hoja quedaba con dos franjas vacías enormes
       (el "muy desnudo" del feedback). */
    margin-top: -13%;
    margin-bottom: -13%;
  }

  .aliado--reverse .aliado-photo-link,
  .aliado--reverse .aliado-photo--static {
    transform: rotate(3deg);
  }

  .aliado-photo-link:hover {
    transform: rotate(-1deg) scale(1.02);
  }

  .aliado--reverse .aliado-photo-link:hover {
    transform: rotate(1deg) scale(1.02);
  }

  .aliado-photo {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Info column */
  .aliado-info-col {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 1rem;
  }

  /* Paper */
  /* Alineado al mismo eje que la descripción: antes el papel se pegaba al
     borde opuesto y la columna quedaba con dos márgenes izquierdos. */
  .aliado-paper-wrap {
    position: relative;
    align-self: flex-start;
  }

  /* Per-aliado paper sizing/padding (different PNG proportions) */
  .aliado-paper-wrap--agustina-albarracin {
    width: 380px;
  }

  .aliado-paper-wrap--agustina-albarracin .aliado-paper-content {
    padding: 18% 16% 18% 14%;
  }

  .aliado-paper-wrap--ignacio-colome {
    width: 520px;
  }

  .aliado-paper-wrap--ignacio-colome .aliado-paper-content {
    padding: 10% 10% 28% 14%;
    gap: 0;
  }

  .aliado-paper-wrap--ignacio-colome .aliado-services-title {
    margin: 0;
  }

  .aliado-paper-bg {
    display: block;
    width: 100%;
    height: auto;
  }

  .aliado-paper-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: #2D2A29;
  }

  .aliado-services-title {
    font-family: 'Glacial Indifference', 'Outfit', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.4rem;
    margin: 0 0 0.3rem;
    letter-spacing: 0.01em;
  }

  .aliado-services {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: 'Glacial Indifference', 'Outfit', system-ui, sans-serif;
    font-weight: 400;
    font-size: 1.2rem;
    line-height: 1.4;
  }

  /* Plain services list (mobile only) */
  .aliado-services-plain {
    display: none;
  }

  .aliado-services-plain-title {
    font-family: 'Courier Prime', 'Courier New', monospace;
    font-weight: 700;
    font-size: 1.1rem;
    color: #2D2A29;
    margin: 0 0 0.4rem;
  }

  .aliado-services-plain-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-family: 'Courier Prime', 'Courier New', monospace;
    font-weight: 400;
    font-size: 1.05rem;
    color: #2D2A29;
    line-height: 1.5;
  }

  /* Logo */
  .aliado-logo {
    display: block;
    width: clamp(280px, 55%, 440px);
    height: auto;
    margin: 0;
  }

  /* Description */
  .aliado-description {
    font-family: 'Courier Prime', 'Courier New', monospace;
    font-weight: 400;
    font-size: 1.2rem;
    color: #2D2A29;
    line-height: 1.6;
    margin: 0;
    max-width: 640px;
  }

  /* Email button */
  .aliado-email-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: flex-start;
    margin-top: 0.5rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    letter-spacing: 0.06em;
    color: #2D2A29;
    background: #F0C14B;
    border-radius: 10px;
    padding: 0.75rem 1.6rem;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .aliado-email-btn:hover {
    background: #2D2A29;
    color: #F0C14B;
  }

  /* Fila de acciones: botón de email + CTA de portfolio. */
  .aliado-actions {
    display: flex;
    flex-wrap: wrap;
    /* En columna siempre: según el ancho de cada columna, el mail y el CTA
       envolvían en un aliado y no en el otro — las dos hojas se veían
       distintas sin motivo. */
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    margin-top: 0.5rem;
  }

  .aliado-email-btn {
    margin-top: 0;
  }

  /* CTA de portfolio: link sutil (texto + flecha + subrayado mostaza), mismo
     patrón de affordance que en el home. El polaroid tambien linkea al
     portfolio, pero sin hover no se entiende — esto lo hace explícito. */
  .aliado-portfolio-cta {
    display: inline-flex;
    align-items: flex-end;
    /* 44px de alto táctil: el subrayado queda pegado al texto y la zona
       tocable crece hacia arriba. */
    min-height: 44px;
    padding-top: 0.75rem;
    gap: 0.5rem;
    color: #2D2A29;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.3rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-bottom: 2px solid #F0C14B;
    padding-bottom: 3px;
    transition: color 0.15s ease;
  }

  .aliado-portfolio-cta span {
    font-size: 1.35rem;
    line-height: 1;
    transition: transform 0.15s ease;
  }

  .aliado-portfolio-cta:hover {
    color: #5C5753;
  }

  .aliado-portfolio-cta:hover span {
    transform: translateX(3px);
  }

  @media (max-width: 1100px) {
    .aliado-paper-wrap--ignacio-colome {
      width: 100%;
      max-width: 480px;
    }
    .aliado-paper-wrap--agustina-albarracin {
      width: 100%;
      max-width: 360px;
    }
  }

  @media (max-width: 900px) {
    .aliados-header {
      padding: 0 1.5rem 1rem;
    }

    .aliados-header-tab {
      margin-left: -1.5rem;
    }

    .aliados-grid {
      /* Menos aire vertical: la foto full-bleed ya es grande, no necesita
         tanto padding arriba ni gap entre aliados. */
      padding: 1rem 1.5rem 2rem;
      gap: 2rem;
    }

    /* En mobile la polaroid es full-bleed (105vw): no puede vivir dentro de
       una hoja con padding, así que la tarjeta se desarma y queda el flujo
       vertical simple. El encabezado (nombre + área) sí se mantiene. */
    .aliado,
    .aliado--reverse {
      /* `1fr` = `minmax(auto, 1fr)`: el mínimo es el min-content de la columna,
         y el pill del email (inline-flex, sin wrap) mide ~336px. A 320px eso
         empujaba TODO el bloque 40px fuera de pantalla — sin scroll-x visible
         (html/body tienen overflow-x: hidden), así que el texto se perdía en
         silencio. `minmax(0, 1fr)` corta la cadena. */
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
      background: none;
      border: none;
      box-shadow: none;
      padding: 0;
      transform: none;
    }

    .aliado:not(:last-child) {
      padding-bottom: 2rem;
      border-bottom: 1.5px dashed rgba(45, 42, 41, 0.25);
    }

    /* Grid explícito: con flex-wrap la píldora del área caía a la segunda
       línea solo en el aliado de nombre largo, y los dos encabezados se veían
       distintos. Así siempre es número + nombre arriba, área debajo. */
    .aliado-head {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: baseline;
      gap: 0.4rem 0.6rem;
      border-bottom: none;
      padding-bottom: 0;
      min-width: 0;
    }

    .aliado-index {
      position: static;
      grid-area: 1 / 1;
      font-size: 2.2rem;
      color: rgba(45, 42, 41, 0.22);
    }

    .aliado-name {
      grid-area: 1 / 2;
    }

    .aliado-area {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: start;
    }

    .aliado-info-col {
      min-width: 0;
    }

    /* A ancho completo y con fuente más chica: el mail largo ya no fuerza el
       ancho de la columna. */
    .aliado-email-btn {
      display: flex;
      width: 100%;
      box-sizing: border-box;
      justify-content: center;
      font-size: 1.1rem;
      padding: 0.8rem 1rem;
      overflow-wrap: anywhere;
    }

    .aliado--reverse .aliado-photo-col {
      order: 0;
    }

    .aliado--reverse .aliado-info-col {
      order: 0;
    }

    /* Pasamos la columna de la foto a flujo normal (block). El truco de
       full-bleed (margin-left: calc(50% - Wvw)) es confiable en block flow,
       pero falla dentro de un flex container + ancestros con overflow-x:hidden
       (que es justo el caso: html/body y .aliados-main lo tienen). */
    .aliado-photo-col {
      display: block;
      max-width: none;
    }

    /* Polaroid full-bleed a 105vw: el marco blanco pasa de los bordes de la
       pantalla. margin-left: calc(50% - 52.5vw) la centra (desborda 2.5vw por
       lado). El overflow-x:hidden global recorta lo que sobra. */
    .aliado-photo-link,
    .aliado-photo--static {
      display: block;
      width: 105vw;
      max-width: none;
      margin-left: calc(50% - 52.5vw);
      /* El PNG de la foto trae ~21% de padding transparente arriba y abajo.
         A 105vw de ancho eso son ~27vw de alto vacío por lado. Lo colapsamos
         con margen negativo para que no haya tanto aire arriba/abajo. */
      margin-top: -28vw;
      margin-bottom: -28vw;
    }

    /* Cada PNG trae padding transparente lateral distinto (Agus 7.9%/19.9%,
       Nacho 18.5%/4.4%): con el mismo margin-left una quedaba pegada a la
       izquierda y la otra a la derecha. Se compensa por slug. */
    .aliado--agustina-albarracin .aliado-photo-link,
    .aliado--agustina-albarracin .aliado-photo--static {
      margin-left: calc(50% - 52.5vw + 6.3vw);
    }

    .aliado--ignacio-colome .aliado-photo-link,
    .aliado--ignacio-colome .aliado-photo--static {
      margin-left: calc(50% - 52.5vw - 7.4vw);
    }

    .aliado-paper-wrap--agustina-albarracin,
    .aliado-paper-wrap--ignacio-colome {
      display: none;
    }

    .aliado-services-plain {
      display: block;
    }

    .aliado-services-title {
      font-size: 1.2rem;
    }

    .aliado-services {
      font-size: 1.05rem;
    }

    .aliado-description {
      font-size: 1.05rem;
    }
  }
</style>
