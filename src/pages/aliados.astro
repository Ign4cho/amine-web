---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { WHATSAPP_URL } from '../constants';

const aliados = await getCollection('aliados');
const sorted = aliados.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Aliados — Amine Social Media">

  <!-- Header -->
  <header class="aliados-header">
    <div class="aliados-header-texture" aria-hidden="true"></div>
    <div class="aliados-header-inner">
      <div class="aliados-header-tab">
        <img src="/assets/tab-aliados.png" alt="" class="aliados-header-tab-img" aria-hidden="true" />
        <span class="aliados-header-tab-label">ALIADOS</span>
      </div>
      <h1 class="aliados-title">Aliados</h1>
      <p class="aliados-subtitle">
        Profesionales de confianza con quienes colaboramos para potenciar cada proyecto.
      </p>
    </div>
  </header>

  <!-- Partner grid -->
  <main class="aliados-main">
    <div class="aliados-grid">
      {sorted.map((aliado, i) => (
        <article class={`aliado-card aliado-card--${i % 2 === 0 ? 'a' : 'b'}`}>
          <!-- Scrapbook-style avatar -->
          <div class="aliado-scrap-wrap">
            <img
              src="/assets/aliados-card-bg.png"
              alt=""
              class="aliado-scrap-bg"
              aria-hidden="true"
            />
            <Image
              src={aliado.data.avatar}
              alt={aliado.data.name}
              width={280}
              height={340}
              class="aliado-avatar-img"
            />
            <p class="aliado-scrap-name">{aliado.data.name}</p>
          </div>

          <!-- Info -->
          <div class="aliado-info">
            <h2 class="aliado-name">{aliado.data.name}</h2>
            <p class="aliado-description">{aliado.data.description}</p>

            <ul class="aliado-services">
              {aliado.data.services.map((service) => (
                <li class="service-tag">{service}</li>
              ))}
            </ul>

            <div class="aliado-contact">
              {aliado.data.contact.type === 'whatsapp' ? (
                <a
                  href={`https://wa.me/${aliado.data.contact.value}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="contact-btn contact-btn--whatsapp"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                    <path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.557 4.117 1.532 5.845L.057 23.492a.5.5 0 0 0 .614.644l5.77-1.508A11.943 11.943 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.886 0-3.65-.523-5.158-1.433l-.36-.215-3.726.974.999-3.629-.236-.374A9.945 9.945 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
                  </svg>
                  WhatsApp
                </a>
              ) : (
                <a
                  href={`mailto:${aliado.data.contact.value}`}
                  class="contact-btn contact-btn--email"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2"/>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                  </svg>
                  Email
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA -->
    <section class="aliados-cta">
      <div class="aliados-cta-texture" aria-hidden="true"></div>
      <div class="aliados-cta-inner">
        <p class="cta-title">¿Querés sumarte a nuestra red de aliados?</p>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-btn"
        >
          Escribinos por WhatsApp
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Header */
  .aliados-header {
    background-color: #2D2A29;
    position: relative;
    overflow: hidden;
    padding: 0 4rem 4rem;
  }

  .aliados-header-texture {
    position: absolute;
    inset: 0;
    background-image: url('/assets/texture-bg.png');
    background-size: cover;
    background-position: center;
    opacity: 0.15;
    pointer-events: none;
  }

  .aliados-header-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
  }

  .aliados-header-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: 319px;
    height: 57px;
    margin-left: -4rem;
    margin-bottom: 2.5rem;
  }

  .aliados-header-tab-img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
  }

  .aliados-header-tab-label {
    position: relative;
    z-index: 1;
    margin-left: 50px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.625rem;
    letter-spacing: 0.04em;
    color: #2D2A29;
    line-height: 1;
  }

  .aliados-title {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(3rem, 8vw, 5rem);
    color: #F9F4EA;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
    line-height: 1;
  }

  .aliados-subtitle {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 1rem;
    color: rgba(249, 244, 234, 0.75);
    margin: 0;
  }

  /* Main */
  .aliados-main {
    background-color: #F9F4EA;
  }

  .aliados-grid {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  /* Partner card */
  .aliado-card {
    display: flex;
    gap: 4rem;
    align-items: flex-start;
  }

  .aliado-card--b {
    flex-direction: row-reverse;
  }

  /* Scrapbook photo */
  .aliado-scrap-wrap {
    flex: 0 0 auto;
    width: 280px;
    height: 340px;
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background-color: #D9D9D9;
    display: flex;
    align-items: flex-end;
    padding: 1rem;
  }

  .aliado-card--a .aliado-scrap-wrap {
    transform: rotate(-3deg);
  }

  .aliado-card--b .aliado-scrap-wrap {
    transform: rotate(3deg);
  }

  .aliado-scrap-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
  }

  .aliado-avatar-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .aliado-scrap-name {
    position: relative;
    z-index: 1;
    font-family: Georgia, serif;
    font-style: italic;
    font-size: 2rem;
    color: #2C2527;
    margin: 0;
    text-shadow: 0 1px 6px rgba(249, 244, 234, 0.8);
  }

  /* Info */
  .aliado-info {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .aliado-name {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: #2D2A29;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1;
  }

  .aliado-description {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 1rem;
    color: #5C5753;
    line-height: 1.6;
    margin: 0;
  }

  .aliado-services {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .service-tag {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem;
    letter-spacing: 0.05em;
    color: #2D2A29;
    background: transparent;
    border: 1.5px solid #F0C14B;
    border-radius: 20px;
    padding: 0.2rem 0.8rem;
  }

  .aliado-contact {
    margin-top: 0.5rem;
  }

  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-radius: 8px;
    padding: 0.6rem 1.5rem;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .contact-btn--whatsapp {
    background: #F0C14B;
    color: #2D2A29;
  }

  .contact-btn--whatsapp:hover {
    background: #2D2A29;
    color: #F0C14B;
  }

  .contact-btn--email {
    background: #2D2A29;
    color: #F9F4EA;
  }

  .contact-btn--email:hover {
    background: #F0C14B;
    color: #2D2A29;
  }

  /* CTA */
  .aliados-cta {
    background-color: #2D2A29;
    position: relative;
    overflow: hidden;
    text-align: center;
    padding: 4rem 1.5rem;
  }

  .aliados-cta-texture {
    position: absolute;
    inset: 0;
    background-image: url('/assets/texture-bg.png');
    background-size: cover;
    background-position: center;
    opacity: 0.15;
    pointer-events: none;
  }

  .aliados-cta-inner {
    position: relative;
    z-index: 1;
  }

  .cta-title {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: #F9F4EA;
    margin: 0 0 1.5rem;
  }

  .cta-btn {
    display: inline-block;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.3rem;
    letter-spacing: 0.06em;
    color: #2D2A29;
    background: #F0C14B;
    border-radius: 10px;
    padding: 0.7rem 2rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .cta-btn:hover {
    background: #F9F4EA;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .aliados-header {
      padding: 0 1.5rem 3rem;
    }

    .aliados-header-tab {
      margin-left: -1.5rem;
    }

    .aliados-grid {
      padding: 3rem 1.5rem;
      gap: 3rem;
    }

    .aliado-card,
    .aliado-card--b {
      flex-direction: column;
    }

    .aliado-scrap-wrap {
      width: 100%;
      max-width: 280px;
      height: 240px;
      align-self: flex-start;
    }

    .aliado-card--a .aliado-scrap-wrap,
    .aliado-card--b .aliado-scrap-wrap {
      transform: rotate(-2deg);
    }
  }
</style>
