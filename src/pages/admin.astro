---
import Layout from '../layouts/Layout.astro';
import { ADMIN_PASSWORD } from '../constants';
import { readdirSync } from 'node:fs';
import blogcitoPosts from '../data/blogcito.json';

// Imágenes ya disponibles en public/blogcito/ — se ofrecen como sugerencia
// en el campo "imagen" para no tener que escribir la ruta de memoria.
let availableImages: string[] = [];
try {
  availableImages = readdirSync('public/blogcito')
    .filter((f) => /\.(png|jpe?g|svg|webp|avif)$/i.test(f))
    .map((f) => `/blogcito/${f}`)
    .sort();
} catch {
  availableImages = [];
}

// Estado publicado actual (lo que hay en src/data/blogcito.json).
const publishedPosts = blogcitoPosts;
---

<Layout title="Admin — Amine Social Media">
  <main class="admin-main">
    <!--
      IMPORTANTE: la contraseña es solo frontend y NO es segura
      criptográficamente. Es una barrera liviana para uso interno del equipo.
    -->
    <div x-data="blogcitoAdmin()" class="admin-container">
      <!-- ─────────────────────────── PASSWORD GATE ─────────────────────────── -->
      <div x-show="!authenticated" class="login-card">
        <div class="login-logo">
          <span class="login-logo-text">AMINE</span>
          <span class="login-logo-sub">Social Media</span>
        </div>

        <h1 class="login-title">Panel de administración</h1>

        <form @submit.prevent="login()" class="login-form">
          <label class="form-label" for="admin-password">Contraseña</label>
          <input
            id="admin-password"
            type="password"
            x-model="password"
            placeholder="Escribí la contraseña"
            class="form-input"
            autocomplete="current-password"
          />
          <p x-show="wrongPassword" class="error-msg" x-cloak>Contraseña incorrecta</p>
          <button type="submit" class="btn-login">Ingresar</button>
        </form>
      </div>

      <!-- ──────────────────────────── ADMIN PANEL ──────────────────────────── -->
      <div x-show="authenticated" x-cloak class="admin-panel">
        <header class="panel-header">
          <div>
            <h1 class="panel-title">Blogcito</h1>
            <p class="panel-subtitle">
              Creá, editá, ordená y borrá las notas del feed.
              <span x-text="`${posts.length} nota${posts.length === 1 ? '' : 's'} · ${posts.filter(p => p.published).length} publicada${posts.filter(p => p.published).length === 1 ? '' : 's'}`"></span>
            </p>
          </div>
          <span class="panel-flag" x-show="dirty" x-cloak>Cambios sin descargar</span>
        </header>

        <div class="panel-body">
          <div class="abm">
            <!-- ── LISTA ────────────────────────────────────────────────── -->
            <section class="abm-list">
              <div class="abm-list-head">
                <h2 class="abm-h2">Notas</h2>
                <button type="button" class="btn-primary btn-sm" @click="newPost()">+ Nueva nota</button>
              </div>

              <p x-show="posts.length === 0" class="abm-empty" x-cloak>
                No hay notas todavía. Creá la primera con “Nueva nota”.
              </p>

              <ul class="abm-items">
                <template x-for="(post, i) in posts" :key="post.id">
                  <li class="abm-item" :class="editingIndex === i && 'abm-item--active'">
                    <div class="abm-item-order">
                      <button type="button" class="btn-icon" @click="move(i, -1)" :disabled="i === 0" title="Subir">▲</button>
                      <span class="abm-item-num" x-text="i + 1"></span>
                      <button type="button" class="btn-icon" @click="move(i, 1)" :disabled="i === posts.length - 1" title="Bajar">▼</button>
                    </div>

                    <img class="abm-item-thumb" :src="post.image" alt="" />

                    <div class="abm-item-info">
                      <span class="abm-item-title" x-text="post.title"></span>
                      <span class="abm-item-meta">
                        <span x-text="post.date"></span>
                        <span x-show="post.tag"> · <span x-text="post.tag"></span></span>
                      </span>
                      <span
                        class="abm-badge"
                        :class="post.published ? 'abm-badge--on' : 'abm-badge--off'"
                        x-text="post.published ? 'Publicada' : 'Borrador'"
                      ></span>
                    </div>

                    <div class="abm-item-actions">
                      <button type="button" class="btn-ghost" @click="togglePublished(i)" x-text="post.published ? 'Despublicar' : 'Publicar'"></button>
                      <button type="button" class="btn-ghost" @click="editPost(i)">Editar</button>
                      <button type="button" class="btn-ghost btn-ghost--danger" @click="removePost(i)">Borrar</button>
                    </div>
                  </li>
                </template>
              </ul>
            </section>

            <!-- ── EDITOR ───────────────────────────────────────────────── -->
            <section class="abm-editor" x-show="editingIndex !== null" x-cloak>
              <h2 class="abm-h2" x-text="editingIndex === -1 ? 'Nueva nota' : 'Editando nota'"></h2>

              <form @submit.prevent="savePost()" class="post-form">
                <div class="form-group">
                  <label class="form-label">Título *</label>
                  <input type="text" x-model="draft.title" @input="syncId()" class="form-input" required />
                </div>

                <div class="form-row form-row--two">
                  <div class="form-group">
                    <label class="form-label">Fecha</label>
                    <input type="date" x-model="draft.date" class="form-input" />
                  </div>
                  <div class="form-group">
                    <label class="form-label">Etiqueta</label>
                    <input type="text" x-model="draft.tag" placeholder="Ej: Branding" class="form-input" />
                  </div>
                </div>

                <div class="form-group">
                  <label class="form-label">Identificador (interno)</label>
                  <input type="text" x-model="draft.id" class="form-input" />
                  <small class="form-hint">Se genera solo desde el título. Tiene que ser único.</small>
                </div>

                <div class="form-group">
                  <label class="form-label">Imagen *</label>
                  <input type="text" x-model="draft.image" list="blogcito-images" class="form-input" placeholder="/blogcito/mi-imagen.jpg" required />
                  <datalist id="blogcito-images">
                    {availableImages.map((img) => <option value={img}></option>)}
                  </datalist>
                  <small class="form-hint">
                    Subí el archivo a la carpeta <code>blogcito/</code> del sitio y escribí acá la ruta.
                    Ideal: 1200×800 px.
                  </small>
                </div>

                <div class="form-group">
                  <label class="form-label">Bajada *</label>
                  <textarea x-model="draft.excerpt" rows="3" class="form-input form-textarea" required
                    placeholder="Las 2 o 3 líneas que se ven siempre, antes del “Leer más”."></textarea>
                </div>

                <div class="form-group">
                  <label class="form-label">Cuerpo *</label>
                  <textarea x-model="draft.body" rows="12" class="form-input form-textarea form-textarea--lg" required
                    placeholder="El texto completo. Dejá una línea en blanco entre párrafo y párrafo."></textarea>
                  <small class="form-hint">Texto plano. Un renglón vacío = párrafo nuevo.</small>
                </div>

                <label class="form-check">
                  <input type="checkbox" x-model="draft.published" />
                  <span>Publicada (visible en el sitio)</span>
                </label>

                <p x-show="formError" x-cloak class="error-msg" x-text="formError"></p>

                <div class="form-actions">
                  <button type="submit" class="btn-primary">Guardar nota</button>
                  <button type="button" class="btn-ghost" @click="cancelEdit()">Cancelar</button>
                </div>
              </form>
            </section>
          </div>

          <!-- ── PUBLICAR ───────────────────────────────────────────────── -->
          <section class="publish">
            <h2 class="abm-h2">Publicar los cambios</h2>
            <p class="publish-text">
              Los cambios quedan guardados en este navegador. Para que se vean en el sitio hay que
              bajar el archivo y pasárselo a quien sube la web.
            </p>

            <div class="publish-actions">
              <button type="button" class="btn-primary" @click="downloadJson()">Descargar blogcito.json</button>
              <button type="button" class="btn-ghost" @click="copyJson()" x-text="copied ? '¡Copiado!' : 'Copiar JSON'"></button>
              <button type="button" class="btn-ghost btn-ghost--danger" @click="resetToPublished()">Descartar mis cambios</button>
            </div>

            <details class="publish-details">
              <summary>¿Cómo se sube al sitio?</summary>
              <ol>
                <li>Descargá <code>blogcito.json</code> con el botón de arriba.</li>
                <li>Si la nota tiene imagen nueva, mandala junto con el archivo.</li>
                <li>Pasale los dos archivos al administrador del sitio: reemplaza
                  <code>src/data/blogcito.json</code>, copia la imagen en <code>public/blogcito/</code>
                  y vuelve a publicar la web.</li>
              </ol>
            </details>

            <details class="publish-details">
              <summary>Ver el JSON generado</summary>
              <pre class="output-code" x-text="json()"></pre>
            </details>
          </section>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script is:inline define:vars={{ ADMIN_PASSWORD, publishedPosts }}>
  document.addEventListener('alpine:init', () => {
    const STORAGE_KEY = 'amine-blogcito-draft';
    const clone = (v) => JSON.parse(JSON.stringify(v));

    window.Alpine.data('blogcitoAdmin', () => ({
      // ── auth (solo frontend, barrera liviana para uso interno) ──
      password: '',
      authenticated: false,
      wrongPassword: false,
      login() {
        if (this.password === ADMIN_PASSWORD) {
          this.authenticated = true;
          this.wrongPassword = false;
        } else {
          this.wrongPassword = true;
          this.password = '';
        }
      },

      // ── estado ──
      posts: [],
      editingIndex: null, // null = cerrado, -1 = nueva, >=0 = índice editado
      draft: {},
      formError: '',
      copied: false,
      dirty: false,

      init() {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          try {
            this.posts = JSON.parse(saved);
            this.dirty = JSON.stringify(this.posts) !== JSON.stringify(publishedPosts);
          } catch {
            this.posts = clone(publishedPosts);
          }
        } else {
          this.posts = clone(publishedPosts);
        }
      },

      persist() {
        this.posts.forEach((p, i) => { p.order = i + 1; });
        localStorage.setItem(STORAGE_KEY, JSON.stringify(this.posts));
        this.dirty = JSON.stringify(this.posts) !== JSON.stringify(publishedPosts);
      },

      // ── ABM ──
      emptyDraft() {
        return {
          id: '',
          title: '',
          date: new Date().toISOString().split('T')[0],
          tag: '',
          image: '',
          excerpt: '',
          body: '',
          order: this.posts.length + 1,
          published: true,
        };
      },

      newPost() {
        this.draft = this.emptyDraft();
        this.editingIndex = -1;
        this.formError = '';
      },

      editPost(i) {
        this.draft = clone(this.posts[i]);
        this.editingIndex = i;
        this.formError = '';
      },

      cancelEdit() {
        this.editingIndex = null;
        this.formError = '';
      },

      slugify(text) {
        return text
          .toLowerCase()
          .normalize('NFD')
          .replace(/[̀-ͯ]/g, '')
          .replace(/[^a-z0-9\s-]/g, '')
          .trim()
          .replace(/\s+/g, '-')
          .slice(0, 60);
      },

      syncId() {
        // Solo autogenera mientras se crea: al editar no se pisa el id existente.
        if (this.editingIndex === -1) this.draft.id = this.slugify(this.draft.title);
      },

      savePost() {
        const d = this.draft;
        if (!d.id) d.id = this.slugify(d.title);
        if (!d.title.trim() || !d.excerpt.trim() || !d.body.trim() || !d.image.trim()) {
          this.formError = 'Faltan campos: título, imagen, bajada y cuerpo son obligatorios.';
          return;
        }
        const duplicated = this.posts.some((p, i) => p.id === d.id && i !== this.editingIndex);
        if (duplicated) {
          this.formError = 'Ya existe otra nota con ese identificador. Cambiá el título o el identificador.';
          return;
        }
        if (!d.tag) delete d.tag;

        if (this.editingIndex === -1) this.posts.push(d);
        else this.posts[this.editingIndex] = d;

        this.editingIndex = null;
        this.formError = '';
        this.persist();
      },

      removePost(i) {
        if (!confirm(`¿Borrar “${this.posts[i].title}”?`)) return;
        this.posts.splice(i, 1);
        if (this.editingIndex === i) this.editingIndex = null;
        this.persist();
      },

      togglePublished(i) {
        this.posts[i].published = !this.posts[i].published;
        this.persist();
      },

      move(i, dir) {
        const j = i + dir;
        if (j < 0 || j >= this.posts.length) return;
        const [item] = this.posts.splice(i, 1);
        this.posts.splice(j, 0, item);
        if (this.editingIndex === i) this.editingIndex = j;
        this.persist();
      },

      // ── salida ──
      json() {
        return JSON.stringify(
          this.posts.map((p, i) => ({ ...p, order: i + 1 })),
          null,
          2,
        );
      },

      downloadJson() {
        const blob = new Blob([this.json() + '\n'], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'blogcito.json';
        a.click();
        URL.revokeObjectURL(url);
      },

      async copyJson() {
        await navigator.clipboard.writeText(this.json());
        this.copied = true;
        setTimeout(() => { this.copied = false; }, 2000);
      },

      resetToPublished() {
        if (!confirm('Se van a perder los cambios que no bajaste. ¿Seguir?')) return;
        this.posts = clone(publishedPosts);
        this.editingIndex = null;
        localStorage.removeItem(STORAGE_KEY);
        this.dirty = false;
      },
    }));
  });
</script>

<style>
  /* Sin min-height: con la card de login (que es chica) el main forzaba el
     alto de la pantalla y quedaban ~600px de cream vacío antes del footer. */
  .admin-main {
    background: #F9F4EA;
    padding: 2.5rem 1.5rem 4rem;
    display: flex;
    justify-content: center;
  }

  .admin-container {
    width: 100%;
    max-width: 1180px;
  }

  /* ───────────────────────────── LOGIN ───────────────────────────── */
  /* Mismo lenguaje de "papel" que las hojas de /aliados y las cards del
     blogcito, en vez del login SaaS genérico (blanco + radius grande). */
  .login-card {
    max-width: 380px;
    margin: 3rem auto;
    background: #FFFDF8;
    border: 1.5px solid rgba(45, 42, 41, 0.22);
    border-radius: 6px;
    padding: 2rem;
    box-shadow: 10px 10px 0 rgba(45, 42, 41, 0.12);
  }

  .login-logo {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .login-logo-text {
    display: block;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.5rem;
    color: #F0C14B;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  .login-logo-sub {
    display: block;
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 0.75rem;
    color: #5C5753;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-top: 0.25rem;
  }

  .login-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem;
    color: #2D2A29;
    text-align: center;
    letter-spacing: 0.04em;
    margin-bottom: 1.5rem;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* ──────────────────────── FORM COMPARTIDO ──────────────────────── */
  .form-label {
    display: block;
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 0.8rem;
    color: #5C5753;
    margin-bottom: 0.3rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .form-input {
    width: 100%;
    background: #F9F4EA;
    border: 1px solid #e0dbd2;
    border-radius: 8px;
    padding: 0.6rem 0.85rem;
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 0.9rem;
    color: #2D2A29;
    outline: none;
    transition: border-color 0.15s ease;
    box-sizing: border-box;
  }

  .form-input:focus {
    border-color: #F0C14B;
  }

  .form-textarea {
    resize: vertical;
    min-height: 80px;
    font-family: 'Courier Prime', monospace;
    line-height: 1.55;
  }

  .form-textarea--lg {
    min-height: 240px;
  }

  .form-hint {
    display: block;
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 0.75rem;
    color: #9e9891;
    margin-top: 0.3rem;
  }

  .form-hint code,
  .publish-details code {
    font-family: 'Courier Prime', monospace;
    background: #F9F4EA;
    border: 1px solid #e8e2d8;
    border-radius: 4px;
    padding: 0 4px;
  }

  .form-row--two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 0.9rem;
    color: #2D2A29;
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .error-msg {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 0.85rem;
    color: #c0392b;
    margin: 0;
  }

  /* ───────────────────────────── BOTONES ─────────────────────────── */
  .btn-login,
  .btn-primary {
    background: #F0C14B;
    color: #2D2A29;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    border: none;
    border-radius: 8px;
    padding: 0.7rem 1.3rem;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .btn-login {
    width: 100%;
    margin-top: 0.5rem;
  }

  .btn-login:hover,
  .btn-primary:hover {
    background: #2D2A29;
    color: #F0C14B;
  }

  .btn-sm {
    font-size: 0.95rem;
    padding: 0.45rem 0.9rem;
  }

  .btn-ghost {
    background: none;
    border: 1px solid #d9d2c6;
    border-radius: 8px;
    padding: 0.45rem 0.85rem;
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 0.82rem;
    color: #2D2A29;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .btn-ghost:hover {
    border-color: #2D2A29;
    background: #F9F4EA;
  }

  .btn-ghost--danger {
    color: #c0392b;
  }

  .btn-ghost--danger:hover {
    border-color: #c0392b;
  }

  /* Flechas de orden: el glifo es chico pero el área táctil tiene que
     llegar a ~28px para poder usarse con el dedo. */
  .btn-icon {
    background: none;
    border: none;
    cursor: pointer;
    color: #5C5753;
    font-size: 0.7rem;
    line-height: 1;
    padding: 0;
    width: 28px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
  }

  .btn-icon:not(:disabled):hover {
    background: #F0C14B;
    color: #2D2A29;
  }

  .btn-icon:disabled {
    opacity: 0.25;
    cursor: default;
  }

  /* ──────────────────────────── PANEL ────────────────────────────── */
  .admin-panel {
    width: 100%;
  }

  .panel-header {
    background: #2D2A29;
    border-radius: 16px 16px 0 0;
    padding: 1.75rem 2rem 1.4rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .panel-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    color: #F0C14B;
    letter-spacing: 0.06em;
    margin: 0 0 0.25rem;
  }

  .panel-subtitle {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 0.85rem;
    color: #F9F4EA;
    opacity: 0.8;
    margin: 0;
  }

  .panel-flag {
    font-family: 'Bebas Neue', sans-serif;
    letter-spacing: 0.06em;
    font-size: 0.9rem;
    color: #2D2A29;
    background: #F0C14B;
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
  }

  .panel-body {
    background: #ffffff;
    border-radius: 0 0 16px 16px;
    padding: 1.75rem 2rem 2rem;
    box-shadow: 0 4px 24px rgba(45, 42, 41, 0.1);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .abm {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .abm-h2 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    letter-spacing: 0.05em;
    color: #2D2A29;
    margin: 0 0 0.9rem;
  }

  .abm-list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .abm-list-head .abm-h2 {
    margin: 0;
  }

  .abm-empty {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 0.9rem;
    color: #9e9891;
  }

  .abm-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .abm-item {
    display: grid;
    grid-template-columns: auto 64px minmax(0, 1fr);
    gap: 0.85rem;
    align-items: center;
    border: 1px solid #e8e2d8;
    border-radius: 10px;
    padding: 0.7rem 0.85rem;
    background: #FFFDF8;
  }

  .abm-item--active {
    border-color: #F0C14B;
    box-shadow: 0 0 0 2px rgba(240, 193, 75, 0.25);
  }

  .abm-item-order {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .abm-item-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1rem;
