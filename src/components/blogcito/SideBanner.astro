---
import { WHATSAPP_URL, INSTAGRAM_URL, TIKTOK_URL } from '../../constants';

// "Publicidad" interna del feed. En desktop vive en el rail derecho (sticky),
// en mobile se intercala entre las notas. Mismo componente, clase distinta.
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<aside class:list={['bbanner', className]}>
  <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="bbanner-card bbanner-card--cta">
    <span class="bbanner-kicker">Espacio Amine</span>
    <p class="bbanner-title">¿Tenés un proyecto<br />dando vueltas?</p>
    <p class="bbanner-text">Contanos qué necesitás y te decimos por dónde empezar. Sin vueltas.</p>
    <span class="bbanner-cta">Escribinos por WhatsApp <span aria-hidden="true">→</span></span>
  </a>

  <div class="bbanner-card bbanner-card--social">
    <span class="bbanner-kicker bbanner-kicker--dark">Seguinos</span>
    <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="bbanner-social">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c0 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2 0-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c0-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.8.07-1.1.05-1.7.24-2.1.4-.5.2-.9.44-1.3.84-.4.4-.64.8-.84 1.3-.16.4-.35 1-.4 2.1C2.5 8.5 2.5 8.9 2.5 12s0 3.5.07 4.8c.05 1.1.24 1.7.4 2.1.2.5.44.9.84 1.3.4.4.8.64 1.3.84.4.16 1 .35 2.1.4 1.3.07 1.7.07 4.8.07s3.5 0 4.8-.07c1.1-.05 1.7-.24 2.1-.4.5-.2.9-.44 1.3-.84.4-.4.64-.8.84-1.3.16-.4.35-1 .4-2.1.07-1.3.07-1.7.07-4.8s0-3.5-.07-4.8c-.05-1.1-.24-1.7-.4-2.1-.2-.5-.44-.9-.84-1.3-.4-.4-.8-.64-1.3-.84-.4-.16-1-.35-2.1-.4C15.5 4 15.1 4 12 4zm0 3.1a4.9 4.9 0 1 1 0 9.8 4.9 4.9 0 0 1 0-9.8zm0 8.08a3.18 3.18 0 1 0 0-6.36 3.18 3.18 0 0 0 0 6.36zm6.24-8.28a1.14 1.14 0 1 1-2.29 0 1.14 1.14 0 0 1 2.29 0z"/>
      </svg>
      @guadasancheznph
    </a>
    <a href={TIKTOK_URL} target="_blank" rel="noopener noreferrer" class="bbanner-social">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-1.78-2.46V9.78a5.72 5.72 0 1 0 4.87 5.66V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3a4.28 4.28 0 0 1-3.24-1.48z"/>
      </svg>
      @espacio.amine
    </a>
  </div>
</aside>

<style>
  .bbanner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bbanner-card {
    border: 2px solid #2D2A29;
    border-radius: 4px;
    box-shadow: 6px 6px 0 rgba(45, 42, 41, 0.9);
    padding: 1.3rem 1.3rem 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-decoration: none;
  }

  .bbanner-card--cta {
    background: #2D2A29;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .bbanner-card--cta:hover {
    transform: translate(-2px, -2px);
    box-shadow: 9px 9px 0 rgba(45, 42, 41, 0.9);
  }

  .bbanner-kicker {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    color: #F0C14B;
    text-transform: uppercase;
  }

  .bbanner-kicker--dark {
    color: #2D2A29;
  }

  .bbanner-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.1;
    color: #F9F4EA;
    margin: 0;
  }

  .bbanner-text {
    font-family: 'Courier Prime', monospace;
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(249, 244, 234, 0.82);
    margin: 0;
  }

  .bbanner-cta {
    margin-top: 0.3rem;
    align-self: flex-start;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    color: #F9F4EA;
    border-bottom: 2px solid #F0C14B;
    padding-bottom: 2px;
  }

  .bbanner-card--social {
    background: #F0C14B;
    gap: 0.5rem;
  }

  .bbanner-social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Courier Prime', monospace;
    font-size: 0.92rem;
    color: #2D2A29;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    align-self: flex-start;
  }

  .bbanner-social:hover {
    border-bottom-color: #2D2A29;
  }
</style>
