---
import { WHATSAPP_URL, CONTACT_EMAIL, INSTAGRAM_URL } from '../constants';
---

<footer class="footer-root">
  <div class="footer-bg" aria-hidden="true"></div>

  <div class="footer-container">
    <!-- Left: brand image -->
    <div class="footer-brand">
      <img
        src="/assets/cta-note.png"
        alt="Amine Social Media"
        class="footer-brand-img"
        loading="lazy"
      />
    </div>

    <!-- Right: nav columns -->
    <nav class="footer-nav" aria-label="Footer navigation">
      <div class="footer-col">
        <p class="footer-col-heading">Servicios</p>
        <ul class="footer-col-list">
          <li>Social Media Manager</li>
          <li>Fotos y Videos</li>
          <li>Dirección Creativa</li>
          <li>Branding</li>
          <li>Desarrollo Web</li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col-heading">Páginas</p>
        <ul class="footer-col-list">
          <li><a href="/">Home</a></li>
          <li><a href="/blogcito">Blogcito</a></li>
          <li><a href="/aliados">Aliados</a></li>
          <li><a href="/contactanos">Contactanos</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col-heading">Contacto</p>
        <ul class="footer-col-list">
          <li>
            <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">
              WhatsApp
            </a>
          </li>
          <li>
            <a href={`mailto:${CONTACT_EMAIL}`}>
              {CONTACT_EMAIL}
            </a>
          </li>
          <li>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
              Instagram
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</footer>

<style>
  .footer-root {
    position: relative;
    overflow: hidden;
    padding: 0 64px 59px;
    background-color: #1a1714;
  }

  .footer-bg {
    position: absolute;
    inset: 0;
    background-image: url('/assets/footer-bg.png');
    background-size: cover;
    background-position: center;
    opacity: 0.55;
    pointer-events: none;
  }

  .footer-container {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 80px;
    align-items: flex-start;
    padding-top: 80px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    flex-wrap: wrap;
  }

  .footer-brand {
    flex: 0 0 auto;
    width: min(280px, 100%);
  }

  .footer-brand-img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    opacity: 0.9;
  }

  .footer-nav {
    flex: 1 1 auto;
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
  }

  .footer-col {
    flex: 0 0 auto;
    min-width: 130px;
  }

  .footer-col-heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    color: #F0C14B;
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(240, 193, 75, 0.3);
  }

  .footer-col-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-col-list li {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 0.9rem;
    color: rgba(249, 244, 234, 0.7);
    line-height: 1.45;
  }

  .footer-col-list a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-col-list a:hover {
    color: #F9F4EA;
  }

  @media (max-width: 768px) {
    .footer-root {
      padding: 0 24px 40px;
    }
    .footer-container {
      gap: 40px;
    }
    .footer-brand {
      width: min(200px, 100%);
    }
    .footer-nav {
      gap: 32px;
    }
  }
</style>
