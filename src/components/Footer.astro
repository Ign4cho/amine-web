---
import {
  WHATSAPP_URL,
  CONTACT_EMAIL,
  INSTAGRAM_URL,
  TIKTOK_URL,
} from '../constants';
---

<footer class="footer-root">
  <div class="footer-bg" aria-hidden="true"></div>

  <div class="footer-container">
    <!-- Left: postit with social handles -->
    <div class="footer-brand">
      <p class="footer-brand-heading">Seguinos</p>
      <div class="footer-postit">
        <img
          src="/assets/home-footer-postit.png"
          alt=""
          aria-hidden="true"
          class="footer-postit-img"
          loading="lazy"
        />
        <ul class="footer-postit-links">
          <li>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
              <svg class="footer-postit-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="3" y="3" width="18" height="18" rx="5" ry="5" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/>
                <circle cx="17.5" cy="6.5" r="1.1" fill="currentColor"/>
              </svg>
              <span>@guadasancheznph</span>
            </a>
          </li>
          <li>
            <a href={TIKTOK_URL} target="_blank" rel="noopener noreferrer">
              <svg class="footer-postit-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M19.5 7.4a6.2 6.2 0 0 1-3.6-1.2A6.1 6.1 0 0 1 13.6 3h-3v12.1a2.8 2.8 0 1 1-2-2.7v-3a5.8 5.8 0 1 0 5 5.7V9.6a9 9 0 0 0 5.9 2.1v-3A6.2 6.2 0 0 1 19.5 7.4z"/>
              </svg>
              <span>@espacio.amine</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Right: nav columns -->
    <nav class="footer-nav" aria-label="Footer navigation">
      <div class="footer-col">
        <p class="footer-col-heading">Servicios</p>
        <ul class="footer-col-list">
          <li>Social Media Manager</li>
          <li>Fotos y Videos</li>
          <li>Dirección Creativa</li>
          <li>Branding</li>
          <li>Desarrollo Web</li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col-heading">Páginas</p>
        <ul class="footer-col-list">
          <li><a href="/">Home</a></li>
          <li><a href="/blogcito">Blogcito</a></li>
          <li><a href="/aliados">Aliados</a></li>
          <li><a href="/contactanos">Contactanos</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="footer-col-heading">Contacto</p>
        <ul class="footer-col-list">
          <li>
            <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">
              WhatsApp
            </a>
          </li>
          <li>
            <a href={`mailto:${CONTACT_EMAIL}`}>
              {CONTACT_EMAIL}
            </a>
          </li>
          <li>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
              Instagram
            </a>
          </li>
          <li>
            <a href={TIKTOK_URL} target="_blank" rel="noopener noreferrer">
              TikTok
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
</footer>

<style>
  .footer-root {
    position: relative;
    overflow: hidden;
    padding: 0 64px 59px;
    background-color: #1a1714;
  }

  /* New background: fondoHomeFooter.png desaturated + blurred, darker overlay */
  .footer-bg {
    position: absolute;
    inset: 0;
    background-image: url('/assets/home-footer-bg.png');
    background-size: cover;
    background-position: center;
    filter: grayscale(1) blur(4px);
    opacity: 0.45;
    pointer-events: none;
    /* Scale up slightly so blur edges aren't visible at the borders */
    transform: scale(1.05);
  }

  .footer-container {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 80px;
    align-items: flex-start;
    padding-top: 80px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    flex-wrap: wrap;
  }

  .footer-brand {
    flex: 0 0 auto;
    width: min(286px, 100%);
    display: flex;
    justify-content: center;
    /* Pull the postit up so the paper body lines up with the nav headings
       (the PNG has transparent space above the washi tape). */
    margin-top: -44px;
  }

  /* Heading "Seguinos" — solo mobile (ver @media), para que el postit se lea
     como un bloque más del footer y no una decoración flotante. */
  .footer-brand-heading {
    display: none;
  }

  .footer-postit {
    position: relative;
    width: 100%;
    max-width: 242px;
    transform: rotate(-3deg);
  }

  .footer-postit-img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Handles overlaid on the postit body (below the washi tape). */
  .footer-postit-links {
    position: absolute;
    top: 34%;
    left: 12%;
    right: 10%;
    bottom: 18%;
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    /* Georgia supports italic natively; Georgia Pro is the brand target. */
    font-family: 'Georgia Pro', Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(0.78rem, 0.95vw, 0.98rem);
    color: #2D2A29;
    line-height: 1.15;
  }

  .footer-postit-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-postit-links a:hover {
    color: #5C5753;
  }

  .footer-postit-icon {
    flex: 0 0 auto;
    width: 1.05em;
    height: 1.05em;
    display: block;
  }

  .footer-nav {
    flex: 1 1 auto;
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
  }

  .footer-col {
    flex: 0 0 auto;
    min-width: 130px;
  }

  .footer-col-heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    color: #F0C14B;
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(240, 193, 75, 0.3);
  }

  .footer-col-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-col-list li {
    font-family: 'Open Sans', sans-serif;
    font-weight: 300;
    font-size: 0.9rem;
    color: rgba(249, 244, 234, 0.8);
    line-height: 1.45;
  }

  .footer-col-list a {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-col-list a:hover {
    color: #F9F4EA;
  }

  @media (max-width: 768px) {
    .footer-root {
      padding: 0 24px 40px;
    }
    .footer-container {
      gap: 28px;
      justify-content: flex-start;
      padding-top: 44px;
    }
    .footer-brand {
      width: 100%;
      /* Mobile: bloque social (heading + postit) debajo de las columnas,
         alineado a la izquierda como el resto para que no quede flotando. */
      order: 2;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      margin-top: 0;
    }
    .footer-brand-heading {
      display: block;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.1rem;
      letter-spacing: 0.06em;
      color: #F0C14B;
      margin: 0;
      padding-bottom: 8px;
      border-bottom: 1px solid rgba(240, 193, 75, 0.3);
      width: 100%;
      max-width: 220px;
    }
    .footer-postit {
      max-width: 210px;
      /* Sube el postit para comer el espacio transparente del PNG (la cinta),
         así queda pegado al heading y no desconectado. */
      margin-top: -34px;
      margin-left: -6px;
    }
    .footer-nav {
      gap: 32px;
      width: 100%;
      justify-content: space-between;
      order: 1;
    }
    .footer-col {
      min-width: 110px;
    }
  }
</style>
