---
const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const navItems = [
  { label: "HOME",         href: "/",            key: "home"        },
  { label: "ALIADOS",      href: "/aliados",     key: "aliados"     },
  { label: "BLOGCITO",     href: "/blogcito",    key: "blogcito"    },
  { label: "CONTACTANOS!", href: "/contactanos", key: "contactanos" },
];
---

<nav class="navbar-root">
  {navItems.map((item) => {
    const active = isActive(item.href);
    return (
      <a
        href={item.href}
        class={`nav-tab ${active ? 'tab-active' : 'tab-inactive'}`}
        aria-current={active ? 'page' : undefined}
      >
        {item.label}
      </a>
    );
  })}
</nav>

<style>
  .navbar-root {
    background-color: #2D2A29;
    width: 100%;
    display: flex;
    align-items: flex-end;
    height: 63px;
    /* Left padding calibrado para que el texto del primer tab (HOME) caiga
       exactamente en 4rem = 64px (mismo left-edge que el contenido del hero).
       Cálculo: 4rem − margin(8px) − padding-left(18px) = 38px. */
    padding: 0 38px;
    position: relative;
    z-index: 100;
    box-sizing: border-box;
  }

  .nav-tab {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-left: 18px;
    position: relative;
    height: 52px;
    margin: 0 8px;
    border-radius: 18px 18px 0 0;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(0.9rem, 2.6vw, 2.375rem);
    letter-spacing: 0.07em;
    text-decoration: none !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    color: #2D2A29;
    background-color: #F0C14B;
    transition: background-color 0.15s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  /* Curved corner fillers */
  .nav-tab::before,
  .nav-tab::after {
    content: "";
    position: absolute;
    bottom: 0;
    width: 12px;
    height: 12px;
    pointer-events: none;
  }

  .nav-tab::before {
    left: -12px;
    background-image: radial-gradient(circle at 0 0, transparent 11.5px, var(--tab-bg, #F0C14B) 12px);
  }

  .nav-tab::after {
    right: -12px;
    background-image: radial-gradient(circle at 100% 0, transparent 11.5px, var(--tab-bg, #F0C14B) 12px);
  }

  /* Active tab */
  .tab-active {
    --tab-bg: #F9F4EA;
    background-color: var(--tab-bg) !important;
    color: #2D2A29 !important;
  }

  /* Inactive tab */
  .tab-inactive {
    --tab-bg: #F0C14B;
    background-color: var(--tab-bg) !important;
    color: #2D2A29 !important;
  }

  @media (max-width: 768px) {
    /*
     * Mobile folder-tab proportions:
     *   - Gap between tabs  = 8px  (margin 0 4px each side)
     *   - Corner connectors = 8px  (same size as gap so they fully fill the concave arc)
     *   - Tab height        = 46px inside 56px navbar  (~82%, same ratio as desktop)
     *   - border-radius     = 18px 18px 0 0  (identical to desktop)
     */
    .navbar-root {
      padding: 0 2px;
      height: 50px;
    }

    .nav-tab {
      margin: 0 4px;
      padding-left: 6px;
      justify-content: flex-start;
      height: 36px;
      font-size: clamp(0.62rem, 3vw, 0.9rem);
      letter-spacing: 0.05em;
      border-radius: 18px 18px 0 0;
      text-decoration: none !important;
    }

    /* Connectors: 8px radius, positioned so they completely cover the 8px gap */
    .nav-tab::before,
    .nav-tab::after {
      width: 8px;
      height: 8px;
    }

    .nav-tab::before {
      left: -8px;
      background-image: radial-gradient(circle at 0 0, transparent 7.5px, var(--tab-bg, #F0C14B) 8px);
    }

    .nav-tab::after {
      right: -8px;
      background-image: radial-gradient(circle at 100% 0, transparent 7.5px, var(--tab-bg, #F0C14B) 8px);
    }
  }
</style>
