---
const currentPath = Astro.url.pathname;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const navItems = [
  { label: "HOME",         href: "/",            key: "home"        },
  { label: "ALIADOS",      href: "/aliados",     key: "aliados"     },
  { label: "BLOGCITO",     href: "/blogcito",    key: "blogcito"    },
  { label: "CONTACTANOS!", href: "/contactanos", key: "contactanos" },
];
---

<nav class="navbar-root">
  {navItems.map((item) => {
    const active = isActive(item.href);
    return (
      <a
        href={item.href}
        class={`nav-tab ${active ? 'tab-active' : 'tab-inactive'}`}
        aria-current={active ? 'page' : undefined}
      >
        {item.label}
      </a>
    );
  })}
</nav>

<style>
  .navbar-root {
    background-color: #2D2A29;
    width: 100%;
    display: flex;
    align-items: flex-end;
    height: 63px;
    padding: 0 14px;
    position: relative;
    z-index: 100;
    box-sizing: border-box;
  }

  .nav-tab {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-left: 18px;
    position: relative;
    height: 52px;
    margin: 0 8px;
    border-radius: 18px 18px 0 0;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(0.9rem, 2.6vw, 2.375rem);
    letter-spacing: 0.07em;
    text-decoration: none !important;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    color: #2D2A29;
    background-color: #F0C14B;
    transition: background-color 0.15s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  /* Curved corner fillers */
  .nav-tab::before,
  .nav-tab::after {
    content: "";
    position: absolute;
    bottom: 0;
    width: 12px;
    height: 12px;
    pointer-events: none;
  }

  .nav-tab::before {
    left: -12px;
    background-image: radial-gradient(circle at 0 0, transparent 11.5px, var(--tab-bg, #F0C14B) 12px);
  }

  .nav-tab::after {
    right: -12px;
    background-image: radial-gradient(circle at 100% 0, transparent 11.5px, var(--tab-bg, #F0C14B) 12px);
  }

  /* Active tab */
  .tab-active {
    --tab-bg: #F9F4EA;
    background-color: var(--tab-bg) !important;
    color: #2D2A29 !important;
  }

  /* Inactive tab */
  .tab-inactive {
    --tab-bg: #F0C14B;
    background-color: var(--tab-bg) !important;
    color: #2D2A29 !important;
  }

  @media (max-width: 768px) {
    .navbar-root {
      padding: 0 4px;
      height: 56px;
    }
    .nav-tab::after {
      right: -6px;
      background-image: radial-gradient(circle at 100% 0, transparent 5.5px, var(--tab-bg, #F0C14B) 6px);
    }
  }
</style>
